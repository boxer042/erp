generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// 인증 & 사용자
// ============================================================

enum UserRole {
  ADMIN
  STAFF
}

model User {
  id         String   @id @default(uuid())
  supabaseId String   @unique @map("supabase_id")
  email      String   @unique
  name       String
  role       UserRole @default(STAFF)
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  createdOrders             Order[]
  createdIncomings          Incoming[]
  createdPurchaseOrders     PurchaseOrder[]
  supplierPayments          SupplierPayment[]
  customerPayments          CustomerPayment[]
  customerRefunds           CustomerRefund[]
  supplierReturns           SupplierReturn[]
  createdQuotations         Quotation[]
  createdStatements         Statement[]
  customerNotes             CustomerNote[]
  createdRepairs            RepairTicket[]
  assignedRepairs           RepairTicket[]            @relation("RepairAssignee")
  createdSymptomTemplates   RepairSymptomTemplate[]   @relation("SymptomTemplateCreator")
  createdDiagnosisTemplates RepairDiagnosisTemplate[] @relation("DiagnosisTemplateCreator")
  createdRentals            Rental[]
  createdExpenses           Expense[]
  posSessions               PosSession[]
  auditLogs                 AuditLog[]
  productPriceChanges       ProductPriceHistory[]     @relation("ProductPriceHistoryChangedBy")

  @@map("users")
}

// ============================================================
// Audit Log — 사용자 활동 로그 (회계/규제 대응)
// ============================================================

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?  @map("user_id")
  user      User?    @relation(fields: [userId], references: [id])
  // 엔티티 타입 — "Order", "Incoming", "PurchaseOrder", "Supplier", "Customer", ...
  entity    String
  // 엔티티 ID — 삭제된 row 도 추적 가능하도록 nullable
  entityId  String?  @map("entity_id")
  // 액션 — "CREATE" / "UPDATE" / "DELETE" / "CONFIRM" / "CANCEL" / "STATUS_CHANGE"
  action    String
  // 변경 전/후 스냅샷 (선택). 큰 row 는 핵심 필드만 추출해서 저장 권장
  before    Json?
  after     Json?
  // 추가 컨텍스트 — 예: status 전환의 from/to, 금액 변경 등
  meta      Json?
  ipAddress String?  @map("ip_address")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([entity, entityId])
  @@index([userId])
  @@index([createdAt])
  @@index([action])
  @@map("audit_logs")
}

// ============================================================
// 판매 채널
// ============================================================

model SalesChannel {
  id             String   @id @default(uuid())
  name           String   @unique
  code           String   @unique
  commissionRate Decimal  @default(0) @map("commission_rate") @db.Decimal(5, 4)
  isActive       Boolean  @default(true) @map("is_active")
  memo           String?
  logoUrl        String?  @map("logo_url")
  logoPath       String?  @map("logo_path")
  /**
   * 채널 운영 정책·credentials 보관 JSON.
   * 구조 (선택 필드):
   * - pollingMinutes: number   — cron 호출 간격 (default 10)
   * - shipDateOffsetDays: number — 출고 예정일 offset (쿠팡=1, 네이버=정책별)
   * - autoStockSync: boolean   — Inventory 변동 시 채널에 push 여부 (default false)
   * - autoTrackingPush: boolean — ERP [발송] 시 송장 자동 push 여부 (default true)
   * - credentials: { ... }     — OAuth/API 키 (Phase 2 — 가입 후 입력)
   * - pendingThreshold: number — 보류 큐 임계값 (이 수 초과 시 알림)
   */
  config         Json?    @map("config")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  channelFees             ChannelFee[]
  channelPricings         ChannelPricing[]
  orders                  Order[]
  sellingCosts            SellingCost[]
  channelCategoryMappings ChannelCategoryMapping[]
  productMappings         ChannelProductMapping[]
  pendingOrders           PendingChannelOrder[]
  outboundJobs            ChannelOutboundJob[]

  @@map("sales_channels")
}

/**
 * 외부 채널 outbound 자동 retry 큐.
 * 흐름:
 * - ERP 액션 후 outbound 호출 시 즉시 try → 실패하면 이 큐에 enqueue
 * - cron `/api/cron/outbound-retry` 가 PENDING + nextAttemptAt < now 항목을 drain
 * - 재시도 실패: attempts++ + nextAttemptAt 미루기(exponential backoff: 2^attempts 분)
 * - attempts >= maxAttempts: status=FAILED (영구 실패 — 운영자 수동 처리)
 * - 성공: status=SUCCESS + resolvedAt 기록
 * payload 형식:
 * PUSH_TRACKING:    { channelOrderNo, carrier, trackingNumber }
 * PUSH_STOCK:       { items: [{ channelSku, availableQty }] }
 * ACCEPT_RETURN:    { channelOrderNo }
 * REJECT_RETURN:    { channelOrderNo, reason }
 */
enum ChannelOutboundJobKind {
  PUSH_TRACKING
  PUSH_STOCK
  ACCEPT_RETURN
  REJECT_RETURN
}

enum ChannelOutboundJobStatus {
  PENDING
  SUCCESS
  FAILED
}

model ChannelOutboundJob {
  id            String                   @id @default(uuid())
  channelId     String                   @map("channel_id")
  channel       SalesChannel             @relation(fields: [channelId], references: [id], onDelete: Cascade)
  kind          ChannelOutboundJobKind
  /**
   * 어댑터 호출 입력값 — JSON. 재시도 시 그대로 push
   */
  payload       Json
  status        ChannelOutboundJobStatus @default(PENDING)
  attempts      Int                      @default(0)
  /**
   * 최대 시도 횟수 — 초과 시 FAILED. 기본 5
   */
  maxAttempts   Int                      @default(5) @map("max_attempts")
  /**
   * 다음 시도 가능 시각 — exponential backoff. 초기엔 즉시 (now)
   */
  nextAttemptAt DateTime                 @default(now()) @map("next_attempt_at")
  /**
   * 마지막 에러 메시지 (실패 시)
   */
  lastError     String?                  @map("last_error")
  /**
   * 도메인 ref — orderId(주로). 추적·필터용 nullable
   */
  orderId       String?                  @map("order_id")
  createdAt     DateTime                 @default(now()) @map("created_at")
  updatedAt     DateTime                 @updatedAt @map("updated_at")
  resolvedAt    DateTime?                @map("resolved_at")

  @@index([status, nextAttemptAt])
  @@index([channelId, status])
  @@index([orderId])
  @@map("channel_outbound_jobs")
}

/**
 * 채널 SKU ↔ ERP Product 매핑. 1:1 (단일) 또는 1:N (세트·번들) 지원.
 * - **단일 (1:1)**: productId 직접 사용. components 는 없음. 가장 흔한 케이스.
 * - **다중 (1:N)**: productId=null + components 여러 개. 채널의 "선물세트" SKU 가
 * ERP 의 [상품X 2개 + 상품Y 1개] 처럼 풀어지는 경우.
 * import 시 components 가 있으면 우선 (productId 무시), 없으면 productId 사용.
 * unique: 한 채널 내에서 channelSku 는 한 매핑에만 (단일이든 다중이든).
 */
model ChannelProductMapping {
  id                   String                           @id @default(uuid())
  channelId            String                           @map("channel_id")
  channel              SalesChannel                     @relation(fields: [channelId], references: [id], onDelete: Cascade)
  channelSku           String                           @map("channel_sku")
  /**
   * 채널이 보내주는 상품명 — 매핑 UI 에서 hint 로 표시
   */
  channelName          String?                          @map("channel_name")
  /**
   * 단일 매핑일 때 사용. components 가 있으면 무시 (다중 매핑)
   */
  productId            String?                          @map("product_id")
  product              Product?                         @relation(fields: [productId], references: [id])
  /**
   * 옵션값 매핑 — 채널 SKU 가 ERP 옵션값 (특정 색상/사이즈) 에 해당.
   * import 시 OrderItem 에 다음과 같이 반영:
   * - productId = optionValue.mappedProduct.id (SWAP 모드면 swap 된 SKU)
   * - optionSnapshot = { 옵션명: 라벨 }
   * - entryProductId = mapping.productId (대표 상품 — funnel)
   * productId 만 있고 optionValueId 없으면 일반 단일 매핑 (기존 동작).
   */
  productOptionValueId String?                          @map("product_option_value_id")
  productOptionValue   ProductOptionValue?              @relation("ChannelMappingOptionValue", fields: [productOptionValueId], references: [id], onDelete: SetNull)
  /**
   * 다중 매핑 — 한 채널 SKU 가 여러 ERP 상품으로 풀어짐
   */
  components           ChannelProductMappingComponent[]
  createdAt            DateTime                         @default(now()) @map("created_at")
  updatedAt            DateTime                         @updatedAt @map("updated_at")

  @@unique([channelId, channelSku])
  @@index([productId])
  @@index([productOptionValueId])
  @@map("channel_product_mappings")
}

/**
 * 채널 SKU 매핑의 구성품. 두 가지 흐름 다 지원:
 * - **세트 풀이 (1:N)**: 채널 SKU 1개 = ERP 상품 N개 (모두 lineRole=MAIN, productId 직접).
 * 예: "선물세트A" → [상품X × 2, 상품Y × 1].
 * - **메인+옵션+추가 동시 매핑**: lineRole 로 컴포넌트 역할 분리.
 * 예: 한 채널 SKU = [상품X(MAIN) + ProductOptionValue(OPTION 의 mappedProduct) + 상품Z(ADDON 사은품)]
 * import.ts 가 lineRole 보고 OrderItem 의 lineRole / parentItemId / optionSnapshot 자동 부여.
 * 부모 ChannelProductMapping 의 단일 productId / productOptionValueId 는 components[] 가 비어있을 때만
 * 폴백으로 사용 (1:1 케이스 backward-compat). components[] 가 있으면 부모 단일 필드 무시.
 */
enum ChannelMappingComponentRole {
  MAIN
  OPTION
  ADDON
}

model ChannelProductMappingComponent {
  id                   String                      @id @default(uuid())
  mappingId            String                      @map("mapping_id")
  mapping              ChannelProductMapping       @relation(fields: [mappingId], references: [id], onDelete: Cascade)
  /**
   * 컴포넌트 역할 — MAIN(기본 라인) / OPTION(옵션 매핑) / ADDON(추가구매·사은품). 미설정 시 MAIN.
   */
  lineRole             ChannelMappingComponentRole @default(MAIN) @map("line_role")
  /**
   * 컴포넌트의 ERP Product. lineRole=OPTION 인 경우 productOptionValue.mappedProduct 와 일치하거나,
   * 직접 productId 만 두고 productOptionValue 는 null 이어도 OK (옵션 라벨만 보존, mappedProduct 는 productId 동일).
   */
  productId            String                      @map("product_id")
  product              Product                     @relation(fields: [productId], references: [id])
  /**
   * lineRole=OPTION 일 때 options snapshot 부여용 — ProductOptionValue link.
   * import 시 OrderItem.optionSnapshot = { 옵션명: 라벨 } 자동 채움.
   * 미설정이면 옵션 라벨 안 들어감 (그냥 OPTION_REF 라인만 생성).
   */
  productOptionValueId String?                     @map("product_option_value_id")
  productOptionValue   ProductOptionValue?         @relation("ChannelMappingComponentOption", fields: [productOptionValueId], references: [id], onDelete: SetNull)
  /**
   * 채널 SKU 1개당 ERP 상품 몇 개
   */
  quantity             Decimal                     @default(1) @db.Decimal(10, 4)
  createdAt            DateTime                    @default(now()) @map("created_at")

  @@index([mappingId])
  @@index([productId])
  @@index([productOptionValueId])
  @@map("channel_product_mapping_components")
}

/**
 * 외부 채널 import 보류 큐.
 * SKU 매핑 누락 등으로 즉시 Order 로 변환 못한 raw order 를 격리 보관.
 * 사용자가 매핑 후 resolve 하면 정식 Order 로 승격.
 */
model PendingChannelOrder {
  id              String                    @id @default(uuid())
  channelId       String                    @map("channel_id")
  channel         SalesChannel              @relation(fields: [channelId], references: [id], onDelete: Cascade)
  /**
   * 채널 측 주문번호 — 동일 채널 내 unique. 중복 import 방지
   */
  channelOrderNo  String                    @map("channel_order_no")
  /**
   * 어댑터가 받아온 원본 payload 전체. JSON 으로 보존해 추후 디버깅·재변환 가능
   */
  rawPayload      Json                      @map("raw_payload")
  /**
   * 보류 사유 — UNMAPPED_SKU(매핑 누락), VALIDATION_FAILED(필드 부족), DUPLICATE(중복), OTHER
   */
  status          PendingChannelOrderStatus @default(UNMAPPED_SKU)
  /**
   * 사람이 읽을 사유 메모 — 어떤 SKU 가 누락됐는지 등
   */
  reason          String?
  /**
   * resolved 되어 정식 Order 로 변환된 경우 그 Order 의 id
   */
  resolvedOrderId String?                   @unique @map("resolved_order_id")
  resolvedAt      DateTime?                 @map("resolved_at")
  createdAt       DateTime                  @default(now()) @map("created_at")
  updatedAt       DateTime                  @updatedAt @map("updated_at")

  @@unique([channelId, channelOrderNo])
  @@index([status])
  @@map("pending_channel_orders")
}

enum PendingChannelOrderStatus {
  UNMAPPED_SKU // 매핑 안 된 SKU 가 있어 보류
  VALIDATION_FAILED // 필수 필드 누락 등
  DUPLICATE // 이미 Order 로 import 된 채널주문번호
  RESOLVED // 매핑 후 정식 Order 로 승격됨
  DISCARDED // 사용자가 import 거부 (스팸·테스트 주문 등)
}

model ChannelFee {
  id        String       @id @default(uuid())
  channelId String       @map("channel_id")
  channel   SalesChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  name      String
  feeType   FeeType      @map("fee_type")
  value     Decimal      @db.Decimal(12, 2)
  isActive  Boolean      @default(true) @map("is_active")
  createdAt DateTime     @default(now()) @map("created_at")

  @@map("channel_fees")
}

enum FeeType {
  PERCENTAGE
  FIXED
}

// ============================================================
// 거래처 (공급자) 관리
// ============================================================

enum PaymentMethod {
  CREDIT
  PREPAID
}

model Supplier {
  id              String        @id @default(uuid())
  name            String
  businessNumber  String?       @map("business_number")
  representative  String?
  phone           String?
  fax             String?
  email           String?
  address         String?
  bankName        String?       @map("bank_name")
  bankAccount     String?       @map("bank_account")
  bankHolder      String?       @map("bank_holder")
  paymentMethod   PaymentMethod @default(CREDIT) @map("payment_method")
  paymentTermDays Int           @default(30) @map("payment_term_days")
  memo            String?
  isActive        Boolean       @default(true) @map("is_active")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  supplierProducts SupplierProduct[]
  incomings        Incoming[]
  purchaseOrders   PurchaseOrder[]
  payments         SupplierPayment[]
  balanceLedger    SupplierLedger[]
  contacts         SupplierContact[]
  supplierReturns  SupplierReturn[]
  quotations       Quotation[]
  expenses         Expense[]

  @@map("suppliers")
}

model SupplierContact {
  id         String   @id @default(uuid())
  supplierId String   @map("supplier_id")
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  name       String
  phone      String?
  email      String?
  position   String?
  memo       String?
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("supplier_contacts")
}

model SupplierLedger {
  id            String          @id @default(uuid())
  supplierId    String          @map("supplier_id")
  supplier      Supplier        @relation(fields: [supplierId], references: [id])
  date          DateTime        @default(now())
  type          LedgerEntryType
  description   String
  debitAmount   Decimal         @default(0) @map("debit_amount") @db.Decimal(15, 2)
  creditAmount  Decimal         @default(0) @map("credit_amount") @db.Decimal(15, 2)
  balance       Decimal         @map("balance") @db.Decimal(15, 2)
  referenceId   String?         @map("reference_id")
  referenceType String?         @map("reference_type")
  createdAt     DateTime        @default(now()) @map("created_at")

  @@index([supplierId, date])
  @@map("supplier_ledgers")
}

enum LedgerEntryType {
  PURCHASE
  PAYMENT
  ADJUSTMENT
  REFUND
}

/**
 * 결제 종류 — 부가세 후납 처리 분류.
 * - MIXED:       기본 — 공급가액 + 부가세 합산 결제 (일반적 케이스)
 * - SUPPLY_ONLY: 공급가액만 결제 (세금계산서 발행 지연으로 부가세는 나중에)
 * - VAT_ONLY:    부가세만 결제 (세금계산서 발행 후 부가세분 별도 송금)
 * 잔액 계산엔 영향 없음 (모두 단순 차감). 분류는 보고·신고 자료용.
 */
enum PaymentKind {
  MIXED
  SUPPLY_ONLY
  VAT_ONLY
}

model SupplierPayment {
  id          String      @id @default(uuid())
  supplierId  String      @map("supplier_id")
  supplier    Supplier    @relation(fields: [supplierId], references: [id])
  amount      Decimal     @db.Decimal(15, 2)
  paymentDate DateTime    @map("payment_date")
  method      String
  kind        PaymentKind @default(MIXED)
  memo        String?
  createdById String      @map("created_by_id")
  createdBy   User        @relation(fields: [createdById], references: [id])
  createdAt   DateTime    @default(now()) @map("created_at")

  @@index([supplierId, paymentDate])
  @@map("supplier_payments")
}

// ============================================================
// 상품 관리
// ============================================================

enum TaxType {
  TAXABLE
  TAX_FREE
}

enum ProductType {
  FINISHED // 완제품
  PARTS // 부속
  SET // 세트상품
  ASSEMBLED // 조립상품
  /**
   * 옵션 대표 상품 — 자체 재고 없는 카탈로그 placeholder.
   * ProductOption 슬롯의 SWAP 옵션값 선택으로 실제 SKU 가 결정됨 (예: 대표 "가습기" → 색상 옵션으로 가습기-화이트/블랙 swap).
   * 상품 등록 시 가격/재고 입력 X, 옵션 슬롯 등록 필수, 결제 시 SWAP 옵션값 선택 강제.
   * variant 도메인(조립부품 변형)과 다른 도메인 — 조립 없이 단순 SKU swap.
   */
  OPTION_PARENT
}

enum ProductLandingMode {
  BLOCKS // 블록 컴포지션 (기본)
  SINGLE_HTML // 단일 HTML 파일 통째로
}

model Product {
  id                   String             @id @default(uuid())
  name                 String
  brand                String?
  brandId              String?            @map("brand_id")
  brandRef             Brand?             @relation(fields: [brandId], references: [id], onDelete: SetNull)
  modelName            String?            @map("model_name")
  spec                 String?
  sku                  String             @unique
  barcode              String?            @unique
  description          String?
  unitOfMeasure        String             @default("EA") @map("unit_of_measure")
  productType          ProductType        @default(FINISHED) @map("product_type")
  taxType              TaxType            @default(TAXABLE) @map("tax_type")
  taxRate              Decimal            @default(0.1) @map("tax_rate") @db.Decimal(5, 4)
  zeroRateEligible     Boolean            @default(false) @map("zero_rate_eligible")
  listPrice            Decimal            @default(0) @map("list_price") @db.Decimal(15, 2)
  sellingPrice         Decimal            @default(0) @map("selling_price") @db.Decimal(15, 2)
  isSet                Boolean            @default(false) @map("is_set")
  isCanonical          Boolean            @default(false) @map("is_canonical")
  canonicalProductId   String?            @map("canonical_product_id")
  canonicalProduct     Product?           @relation("ProductVariants", fields: [canonicalProductId], references: [id], onDelete: SetNull)
  variants             Product[]          @relation("ProductVariants")
  categoryId           String?            @map("category_id")
  category             ProductCategory?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  isBulk               Boolean            @default(false) @map("is_bulk")
  containerSize        Decimal?           @map("container_size") @db.Decimal(10, 4)
  bulkProductId        String?            @map("bulk_product_id")
  bulkProduct          Product?           @relation("ProductBulk", fields: [bulkProductId], references: [id], onDelete: SetNull)
  salesContainers      Product[]          @relation("ProductBulk")
  isActive             Boolean            @default(true) @map("is_active")
  /**
   * 카탈로그 노출 차단 — true 면 자사몰/POS 그리드 등 일반 카탈로그에서 숨김.
   * 옵션 swap 의 대상 SKU(예: 가습기-블랙)를 단독 노출 안 시키고 옵션으로만 선택 가능하게 할 때 사용.
   * 재고/매핑/주문/결제는 정상 작동. isActive=false 와 다름 (그건 삭제·비활성).
   */
  catalogHidden        Boolean            @default(false) @map("catalog_hidden")
  autoMapped           Boolean            @default(false) @map("auto_mapped")
  trackable            Boolean            @default(false) @map("trackable")
  warrantyMonths       Int?               @map("warranty_months")
  imageUrl             String?            @map("image_url")
  memo                 String?
  landingBlocks        Json?              @map("landing_blocks")
  landingMode          ProductLandingMode @default(BLOCKS) @map("landing_mode")
  singleHtmlUrl        String?            @map("single_html_url")
  // 사용법·관리 매뉴얼 — landingBlocks 와 동일한 블록 구조(ManualBlock[]). 시리얼 손님 페이지에서 노출.
  manualBlocks         Json?              @map("manual_blocks")
  hasManual            Boolean            @default(false) @map("has_manual")
  // 상품정보 고시 (전자상거래법 표시 의무)
  countryOfOrigin      String?            @map("country_of_origin")
  manufacturer         String?
  importer             String?
  certifications       String?
  manufactureDate      String?            @map("manufacture_date")
  warrantyPolicy       String?            @map("warranty_policy")
  asResponsible        String?            @map("as_responsible")
  assemblyTemplateId   String?            @map("assembly_template_id")
  assemblyTemplate     AssemblyTemplate?  @relation("ProductDefaultTemplate", fields: [assemblyTemplateId], references: [id], onDelete: SetNull)
  // 원가 변동 안내 — 마지막으로 "확인" 또는 "판매가 조정" 된 시점의 단위 원가(세전).
  // 현재 계산된 unitCost 와 다르면 리스트에 원가↑/↓ 배지 노출. 확인/판매가 수정 시 currentUnitCost 로 갱신.
  acknowledgedUnitCost Decimal?           @map("acknowledged_unit_cost") @db.Decimal(15, 4)
  acknowledgedAt       DateTime?          @map("acknowledged_at")
  acknowledgedById     String?            @map("acknowledged_by_id")
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")

  setComponents            SetComponent[]                   @relation("SetParent")
  partOfSets               SetComponent[]                   @relation("SetChild")
  productMappings          ProductMapping[]
  channelMappings          ChannelProductMapping[]
  channelMappingComponents ChannelProductMappingComponent[]
  productOptions           ProductOption[]
  optionValueMappedAs      ProductOptionValue[]             @relation("OptionValueProduct")
  optionValueVariantAs     ProductOptionValue[]             @relation("OptionValueVariant")
  channelPricings          ChannelPricing[]
  repairPackageParts       RepairPackagePart[]
  inventory                Inventory?
  orderItems               OrderItem[]
  /**
   * B2C funnel — 손님이 진입한 카탈로그 SKU 로 매핑된 OrderItem 들 (자사몰/외부 채널 한정)
   */
  entryOrderItems          OrderItem[]                      @relation("OrderItemEntry")
  /**
   * 이 상품에 연결된 추가구매 추천 (메인=this)
   */
  bundles                  BundleProduct[]                  @relation("BundleMain")
  /**
   * 이 상품이 다른 메인의 추가구매로 등록된 행들 — 카탈로그 삭제 시 참조 차단용
   */
  bundledIn                BundleProduct[]                  @relation("BundleAddon")
  sellingCosts             SellingCost[]
  quotationItems           QuotationItem[]
  statementItems           StatementItem[]
  inventoryLots            InventoryLot[]
  media                    ProductMedia[]
  customerMachines         CustomerMachine[]
  repairParts              RepairPart[]
  repairTickets            RepairTicket[]                   @relation("RepairProduct")
  diagnosisPartUsages      DiagnosisPartUsage[]
  rentalAssets             RentalAsset[]
  serialItems              SerialItem[]

  assemblies                    Assembly[]
  assemblyComponentConsumptions AssemblyComponentConsumption[]
  assemblyTemplateSlotDefaults  AssemblyTemplateSlot[]
  assemblyPresetItems           AssemblyPresetItem[]
  usedItems                     UsedItem[]
  usedItemBuildParts            UsedItemBuildPart[]            @relation("ProductUsedItemBuildPart")

  specValues   ProductSpecValue[]
  priceHistory ProductPriceHistory[]

  @@map("products")
}

/**
 * 우리 상품(Product) 의 정가/판매가 변동 이력.
 * - PUT /api/products/[id] 가 listPrice 또는 sellingPrice 차이 감지 시 row 생성
 * - SupplierProductPriceHistory 와 패턴 동일 — 상품 상세에서 변경 추적용
 * - field: 어느 가격이 바뀌었는지 ("LIST" | "SELLING")
 */
model ProductPriceHistory {
  id            String   @id @default(uuid())
  productId     String   @map("product_id")
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  field         String
  oldPrice      Decimal  @map("old_price") @db.Decimal(15, 2)
  newPrice      Decimal  @map("new_price") @db.Decimal(15, 2)
  changeAmount  Decimal  @map("change_amount") @db.Decimal(15, 2)
  changePercent Decimal  @map("change_percent") @db.Decimal(8, 2)
  reason        String?
  changedById   String?  @map("changed_by_id")
  changedBy     User?    @relation("ProductPriceHistoryChangedBy", fields: [changedById], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([productId, createdAt])
  @@map("product_price_history")
}

enum ProductSpecType {
  TEXT
  NUMBER
  ENUM
}

model ProductSpecSlot {
  id        String          @id @default(uuid())
  name      String          @unique
  type      ProductSpecType
  unit      String?
  options   String[]        @default([])
  order     Int             @default(0)
  isActive  Boolean         @default(true) @map("is_active")
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")

  values ProductSpecValue[]

  @@map("product_spec_slots")
}

model ProductSpecValue {
  id        String          @id @default(uuid())
  productId String          @map("product_id")
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  slotId    String          @map("slot_id")
  slot      ProductSpecSlot @relation(fields: [slotId], references: [id], onDelete: Restrict)
  value     String
  order     Int             @default(0)
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")

  @@unique([productId, slotId])
  @@index([productId])
  @@map("product_spec_values")
}

// ============================================================
// 고객 옵션 (Product Option) — 변형상품(매장 분기) 과 분리된 별도 도메인
// ============================================================
//
// 정책:
//   - 변형상품(매장 variant): 매장이 출고 시점에 결정, 고객 노출 X — 기존 인프라 그대로
//   - 고객 옵션 (이 모델): 고객이 카탈로그·POS 에서 직접 선택, 옵션값마다 별도 처리
//
// 옵션값이 가리킬 수 있는 대상 (셋 중 최대 하나, 셋 다 null 도 가능):
//   - mappedProductId: 다른 Product 매핑 (예: 메모리 32GB) → OrderItem OPTION_REF 별도 라인
//   - mappedVariantId: 매장 variant 매핑 (예: 수냉쿨러 variant) → variant 자동 결정
//   - 둘 다 null: 단순 텍스트 옵션 (예: 색상 화이트) → variant 자동 생성 후속 PR
//
// OrderItem 측에선 lineRole/parentItemId/optionSnapshot 으로 표현됨.

model ProductOption {
  id        String   @id @default(uuid())
  productId String   @map("product_id")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  /**
   * 옵션 슬롯명 — "메모리", "색상", "쿨러" 등
   */
  name      String
  /**
   * 필수 선택 여부 — false 면 미선택도 허용
   */
  required  Boolean  @default(true)
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  values ProductOptionValue[]

  @@index([productId, sortOrder])
  @@map("product_options")
}

/**
 * 옵션값 처리 모드 — mappedProductId 가 있을 때 결제 라인에 어떻게 반영할지.
 * - SWAP:  메인 라인의 productId 자체를 mapped 로 교체. 본 상품의 색상/사이즈 변형 같은 케이스.
 * 예: 대표 "가습기" + "색상=블랙" → 메인 라인이 가습기-블랙 SKU 로 swap. OPTION_PARENT 와 함께 자주 사용.
 * - ADDON: 메인 라인 + OPTION_REF 자식 라인 (별도 OrderItem 자동 생성).
 * 본 상품의 부속/내부 옵션이 별도 SKU로 관리되는 드문 케이스. 일반적인 "추가구매" 도메인은
 * BundleProduct(추후 §3.3 후속) 를 쓰는 게 맞음 — 옵션 안의 ADDON 모드는 사실상 비권장.
 * mappedProductId 도 mappedVariantId 도 없는 단순 텍스트 옵션값은 모드와 무관 (메인 라인 가산만).
 */
enum ProductOptionValueMode {
  SWAP
  ADDON

  @@map("product_option_value_mode")
}

model ProductOptionValue {
  id        String        @id @default(uuid())
  optionId  String        @map("option_id")
  option    ProductOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  /**
   * 옵션값 라벨 — "32GB", "수냉쿨러", "화이트"
   */
  label     String
  /**
   * 추가가 — 메인 가격 대비 차액. SWAP 모드에선 mapped SKU 의 sellingPrice 가 우선이므로 0 권장
   */
  addPrice  Decimal       @default(0) @map("add_price") @db.Decimal(15, 2)
  sortOrder Int           @default(0) @map("sort_order")
  isActive  Boolean       @default(true) @map("is_active")

  /**
   * 옵션값이 다른 Product 를 매핑 — 색상 SKU(SWAP) 또는 부속 SKU(ADDON)
   */
  mappedProductId String?                @map("mapped_product_id")
  mappedProduct   Product?               @relation("OptionValueProduct", fields: [mappedProductId], references: [id], onDelete: SetNull)
  /**
   * 옵션값이 매장 variant 를 결정 — 쿨러 → 수냉쿨러 variant (Phase 3 자동 Assembly)
   */
  mappedVariantId String?                @map("mapped_variant_id")
  mappedVariant   Product?               @relation("OptionValueVariant", fields: [mappedVariantId], references: [id], onDelete: SetNull)
  /**
   * mappedProductId 처리 모드 — SWAP(메인 라인 교체) / ADDON(자식 라인 추가).
   * mappedProductId 없으면 무시. 기본 SWAP — 옵션값에서 매핑하는 일반 케이스가 SWAP(색상 등).
   */
  mappedMode      ProductOptionValueMode @default(SWAP) @map("mapped_mode")

  /**
   * 외부 채널 SKU 가 이 옵션값을 가리키는 매핑들 — onDelete=SetNull (옵션값 삭제 시 매핑 해제)
   */
  channelMappings          ChannelProductMapping[]          @relation("ChannelMappingOptionValue")
  channelMappingComponents ChannelProductMappingComponent[] @relation("ChannelMappingComponentOption")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([optionId, sortOrder])
  @@map("product_option_values")
}

/**
 * 추가구매 추천 (BundleProduct) — 메인 상품과 함께 사면 좋은 별도 카탈로그 상품 매핑.
 * ProductOption 과 분리된 도메인:
 * - ProductOption: 메인 상품의 선택지 (색상/사이즈) — 손님이 반드시 한 값 선택
 * - BundleProduct: 별도 카탈로그 상품 추천 — 손님이 클릭해서 추가 (단독 판매도 됨)
 * 흐름: 메인 상품을 카트에 담을 때 추천 모달 노출 → 손님이 ADDON 선택 시 자식 카트 라인 + OrderItem.lineRole=ADDON.
 * 메인 라인 삭제/취소 시 자식 ADDON 라인은 cascade — 추가구매는 메인의 부산물이라 단독 의미 약함.
 */
model BundleProduct {
  id               String   @id @default(uuid())
  /**
   * 메인 상품 — 이 상품 카탈로그에서 추가구매 추천 노출
   */
  mainProductId    String   @map("main_product_id")
  mainProduct      Product  @relation("BundleMain", fields: [mainProductId], references: [id], onDelete: Cascade)
  /**
   * 추가 상품 — 함께 사면 좋은 단독 카탈로그 상품. 카탈로그 삭제는 참조 있으면 차단 (Restrict)
   */
  bundleProductId  String   @map("bundle_product_id")
  bundleProduct    Product  @relation("BundleAddon", fields: [bundleProductId], references: [id], onDelete: Restrict)
  /**
   * 추천 시 기본 수량 (대부분 1)
   */
  defaultQuantity  Decimal  @default(1) @map("default_quantity") @db.Decimal(15, 4)
  /**
   * 번들 할인액 (세전) — 본 상품의 sellingPrice 에서 차감되는 할인.
   * null 이면 정가 그대로. 음수 금지. 카트 추가 시 unitPrice = bundle.sellingPrice − discountAmount.
   */
  discountAmount   Decimal? @map("discount_amount") @db.Decimal(15, 2)
  /**
   * 추천 카피 — "필터도 함께 쓰세요", "정수기 살균 전용 세제" 같은 짧은 안내
   */
  recommendMessage String?  @map("recommend_message")
  sortOrder        Int      @default(0) @map("sort_order")
  isActive         Boolean  @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([mainProductId, bundleProductId])
  @@index([mainProductId, sortOrder])
  @@map("bundle_products")
}

model Brand {
  id        String    @id @default(uuid())
  name      String    @unique
  logoUrl   String?   @map("logo_url")
  logoPath  String?   @map("logo_path")
  memo      String?
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  products  Product[]

  @@map("brands")
}

model ProductCategory {
  id        String            @id @default(uuid())
  name      String
  parentId  String?           @map("parent_id")
  parent    ProductCategory?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children  ProductCategory[] @relation("CategoryTree")
  imageUrl  String?           @map("image_url")
  imagePath String?           @map("image_path")
  order     Int               @default(0)
  isActive  Boolean           @default(true) @map("is_active")
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")

  products           Product[]
  channelMappings    ChannelCategoryMapping[]
  // 새 수리 접수 시 선택한 카테고리 (RepairTicket.repairCategoryId)
  repairTickets      RepairTicket[]            @relation("RepairCategory")
  // 카테고리별 증상·진단 템플릿
  symptomTemplates   RepairSymptomTemplate[]   @relation("SymptomCategory")
  diagnosisTemplates RepairDiagnosisTemplate[] @relation("DiagnosisCategory")
  // 조립 슬롯라벨의 후보 상품 카테고리
  slotLabels         AssemblySlotLabel[]       @relation("SlotLabelCategory")

  @@map("product_categories")
}

model ChannelCategoryMapping {
  id                  String          @id @default(uuid())
  categoryId          String          @map("category_id")
  category            ProductCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  channelId           String          @map("channel_id")
  channel             SalesChannel    @relation(fields: [channelId], references: [id], onDelete: Cascade)
  channelCategoryCode String          @map("channel_category_code")
  channelCategoryName String?         @map("channel_category_name")

  @@unique([categoryId, channelId])
  @@map("channel_category_mappings")
}

enum SupplierProductSource {
  MANUAL
  INITIAL
  INCOMING
}

model SupplierProduct {
  id            String                @id @default(uuid())
  supplierId    String                @map("supplier_id")
  supplier      Supplier              @relation(fields: [supplierId], references: [id])
  name          String
  spec          String?
  supplierCode  String?               @map("supplier_code")
  unitOfMeasure String                @default("EA") @map("unit_of_measure")
  listPrice     Decimal               @default(0) @map("list_price") @db.Decimal(15, 2)
  unitPrice     Decimal               @default(0) @map("unit_price") @db.Decimal(15, 2)
  isTaxable     Boolean               @default(true) @map("is_taxable")
  currency      String                @default("KRW")
  leadTimeDays  Int?                  @map("lead_time_days")
  minOrderQty   Int                   @default(1) @map("min_order_qty")
  source        SupplierProductSource @default(MANUAL)
  isProvisional Boolean               @default(false) @map("is_provisional")
  isActive      Boolean               @default(true) @map("is_active")
  memo          String?
  createdAt     DateTime              @default(now()) @map("created_at")
  updatedAt     DateTime              @updatedAt @map("updated_at")

  productMappings    ProductMapping[]
  incomingItems      IncomingItem[]
  incomingCosts      IncomingCost[]
  priceHistory       SupplierProductPriceHistory[]
  returnItems        SupplierReturnItem[]
  quotationItems     QuotationItem[]
  purchaseOrderItems PurchaseOrderItem[]
  inventoryLots      InventoryLot[]

  @@unique([supplierId, supplierCode])
  @@map("supplier_products")
}

model SupplierProductPriceHistory {
  id                String          @id @default(uuid())
  supplierProductId String          @map("supplier_product_id")
  supplierProduct   SupplierProduct @relation(fields: [supplierProductId], references: [id], onDelete: Cascade)
  oldPrice          Decimal         @map("old_price") @db.Decimal(15, 2)
  newPrice          Decimal         @map("new_price") @db.Decimal(15, 2)
  changeAmount      Decimal         @map("change_amount") @db.Decimal(15, 2)
  changePercent     Decimal         @map("change_percent") @db.Decimal(8, 2)
  originalPrice     Decimal?        @map("original_price") @db.Decimal(15, 2)
  discountAmount    Decimal?        @map("discount_amount") @db.Decimal(15, 2)
  reason            String?
  incomingId        String?         @map("incoming_id")
  createdAt         DateTime        @default(now()) @map("created_at")

  @@map("supplier_product_price_history")
}

model ProductMapping {
  id                String          @id @default(uuid())
  supplierProductId String          @map("supplier_product_id")
  supplierProduct   SupplierProduct @relation(fields: [supplierProductId], references: [id], onDelete: Cascade)
  productId         String          @map("product_id")
  product           Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  conversionRate    Decimal         @default(1) @map("conversion_rate") @db.Decimal(10, 4)
  createdAt         DateTime        @default(now()) @map("created_at")

  @@unique([supplierProductId, productId])
  @@map("product_mappings")
}

model SetComponent {
  id           String                @id @default(uuid())
  setProductId String                @map("set_product_id")
  setProduct   Product               @relation("SetParent", fields: [setProductId], references: [id], onDelete: Cascade)
  componentId  String                @map("component_id")
  component    Product               @relation("SetChild", fields: [componentId], references: [id], onDelete: Restrict)
  quantity     Decimal               @db.Decimal(10, 4)
  label        String?
  slotLabelId  String?               @map("slot_label_id")
  slotLabel    AssemblySlotLabel?    @relation(fields: [slotLabelId], references: [id], onDelete: SetNull)
  slotId       String?               @map("slot_id")
  slot         AssemblyTemplateSlot? @relation(fields: [slotId], references: [id], onDelete: SetNull)
  createdAt    DateTime              @default(now()) @map("created_at")

  // 같은 부속을 서로 다른 슬롯에 배치하는 ASSEMBLED 케이스 지원을 위해 unique 제거.
  // 중복 판정은 UI 가 (슬롯키, componentId) 튜플 기준으로 처리.
  @@index([setProductId, componentId])
  @@index([slotLabelId])
  @@index([slotId])
  @@map("set_components")
}

model ChannelPricing {
  id           String       @id @default(uuid())
  productId    String       @map("product_id")
  product      Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  channelId    String       @map("channel_id")
  channel      SalesChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  sellingPrice Decimal      @map("selling_price") @db.Decimal(15, 2)
  isActive     Boolean      @default(true) @map("is_active")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  @@unique([productId, channelId])
  @@map("channel_pricings")
}

// ============================================================
// 비용 관리
// ============================================================

model IncomingCost {
  id                String          @id @default(uuid())
  supplierProductId String          @map("supplier_product_id")
  supplierProduct   SupplierProduct @relation(fields: [supplierProductId], references: [id], onDelete: Cascade)
  name              String
  costType          FeeType         @map("cost_type")
  value             Decimal         @db.Decimal(12, 2)
  perUnit           Boolean         @default(true) @map("per_unit")
  isTaxable         Boolean         @default(true) @map("is_taxable")
  isActive          Boolean         @default(true) @map("is_active")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @default(now()) @updatedAt @map("updated_at")

  @@map("incoming_costs")
}

model SellingCost {
  id        String        @id @default(uuid())
  productId String        @map("product_id")
  product   Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  channelId String?       @map("channel_id")
  channel   SalesChannel? @relation(fields: [channelId], references: [id], onDelete: Cascade)
  name      String
  costType  FeeType       @map("cost_type")
  value     Decimal       @db.Decimal(12, 2)
  perUnit   Boolean       @default(true) @map("per_unit")
  isTaxable Boolean       @default(true) @map("is_taxable")
  isActive  Boolean       @default(true) @map("is_active")
  createdAt DateTime      @default(now()) @map("created_at")

  @@index([productId, channelId])
  @@map("selling_costs")
}

// ============================================================
// 재고 관리
// ============================================================

model Inventory {
  id               String    @id @default(uuid())
  productId        String    @unique @map("product_id")
  product          Product   @relation(fields: [productId], references: [id])
  quantity         Decimal   @default(0) @db.Decimal(15, 4)
  safetyStock      Decimal   @default(1) @map("safety_stock") @db.Decimal(15, 4)
  avgCost          Decimal?  @map("avg_cost") @db.Decimal(15, 4)
  avgCostUpdatedAt DateTime? @map("avg_cost_updated_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  movements InventoryMovement[]

  @@map("inventories")
}

enum MovementType {
  INCOMING
  OUTGOING
  ADJUSTMENT_PLUS
  ADJUSTMENT_MINUS
  SET_CONSUME
  SET_PRODUCE
  RETURN
  INITIAL
  STOCKTAKE_PLUS
  STOCKTAKE_MINUS
  INTERNAL_USE
  BOTTLE_OPEN_OUT
  BOTTLE_OPEN_IN
}

enum InventoryUsageReason {
  SAMPLE
  SELF_USE
  DAMAGE
  LOSS
  SUPPLIES
}

enum StocktakeReason {
  PHYSICAL_COUNT
  DAMAGE
  LOSS
  FOUND
  SAMPLE
  MISCOUNT
  OTHER
}

model InventoryMovement {
  id            String                @id @default(uuid())
  inventoryId   String                @map("inventory_id")
  inventory     Inventory             @relation(fields: [inventoryId], references: [id])
  type          MovementType
  quantity      Decimal               @db.Decimal(15, 4)
  balanceAfter  Decimal               @map("balance_after") @db.Decimal(15, 4)
  reason        StocktakeReason?
  usageReason   InventoryUsageReason? @map("usage_reason")
  referenceId   String?               @map("reference_id")
  referenceType String?               @map("reference_type")
  memo          String?
  createdAt     DateTime              @default(now()) @map("created_at")

  @@index([inventoryId, createdAt])
  @@map("inventory_movements")
}

// ============================================================
// 입고 관리
// ============================================================

enum IncomingStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

// 입고 결제 상태 — supplier-payment FIFO 자동 매칭용 (현금 결제는 항상 PAID, 외상은 UNPAID 로 시작)
enum IncomingPaymentStatus {
  UNPAID
  PAID
}

model Incoming {
  id                String                @id @default(uuid())
  incomingNo        String                @unique @map("incoming_no")
  supplierId        String                @map("supplier_id")
  supplier          Supplier              @relation(fields: [supplierId], references: [id])
  status            IncomingStatus        @default(PENDING)
  paymentStatus     IncomingPaymentStatus @default(UNPAID) @map("payment_status")
  incomingDate      DateTime              @map("incoming_date")
  totalAmount       Decimal               @default(0) @map("total_amount") @db.Decimal(15, 2)
  taxAmount         Decimal               @default(0) @map("tax_amount") @db.Decimal(15, 2)
  shippingCost      Decimal               @default(0) @map("shipping_cost") @db.Decimal(12, 2)
  shippingIsTaxable Boolean               @default(true) @map("shipping_is_taxable")
  shippingDeducted  Boolean               @default(false) @map("shipping_deducted")
  memo              String?
  quotationId       String?               @map("quotation_id")
  quotation         Quotation?            @relation(fields: [quotationId], references: [id])
  purchaseOrderId   String?               @map("purchase_order_id")
  purchaseOrder     PurchaseOrder?        @relation(fields: [purchaseOrderId], references: [id])
  createdById       String                @map("created_by_id")
  createdBy         User                  @relation(fields: [createdById], references: [id])
  createdAt         DateTime              @default(now()) @map("created_at")
  updatedAt         DateTime              @updatedAt @map("updated_at")

  items          IncomingItem[]
  supplierReturn SupplierReturn?

  @@index([supplierId, incomingDate])
  @@index([supplierId, paymentStatus, incomingDate])
  @@index([purchaseOrderId])
  @@map("incomings")
}

model IncomingItem {
  id                    String             @id @default(uuid())
  incomingId            String             @map("incoming_id")
  incoming              Incoming           @relation(fields: [incomingId], references: [id], onDelete: Cascade)
  supplierProductId     String             @map("supplier_product_id")
  supplierProduct       SupplierProduct    @relation(fields: [supplierProductId], references: [id])
  inventoryLots         InventoryLot[]
  quantity              Decimal            @db.Decimal(15, 4)
  originalPrice         Decimal?           @map("original_price") @db.Decimal(15, 2)
  discountAmount        Decimal?           @map("discount_amount") @db.Decimal(15, 2)
  unitPrice             Decimal            @map("unit_price") @db.Decimal(15, 2)
  totalPrice            Decimal            @map("total_price") @db.Decimal(15, 2)
  unitCostSnapshot      Decimal?           @map("unit_cost_snapshot") @db.Decimal(15, 4)
  itemShippingCost      Decimal?           @map("item_shipping_cost") @db.Decimal(12, 2)
  itemShippingIsTaxable Boolean            @default(true) @map("item_shipping_is_taxable")
  memo                  String?
  purchaseOrderItemId   String?            @map("purchase_order_item_id")
  purchaseOrderItem     PurchaseOrderItem? @relation(fields: [purchaseOrderItemId], references: [id])

  @@index([purchaseOrderItemId])
  @@map("incoming_items")
}

// ============================================================
// 발주 (PurchaseOrder)
// ============================================================
//
// 거래처에게 실제 주문을 넣는 단계. 매입견적서(RFQ)와는 다름.
// 발주 → 입고 흐름:
//   DRAFT(작성중) → SENT(발송) → CONFIRMED(거래처 수락) → PARTIAL(분할 입고 진행) →
//     RECEIVED(전량 입고) | CLOSED(부분만 받고 조기 종료) | CANCELLED(취소)
// 한 발주에서 여러 입고로 분할 가능 (PurchaseOrderItem.receivedQty 누적).

enum PurchaseOrderStatus {
  DRAFT
  SENT
  CONFIRMED
  COUNTER_OFFER // 거래처가 단가 변경 요청 — 우리(발주자)가 수락/거절 결정
  PARTIAL // 부분입고 발생 (일부 받음, 결정 대기)
  PARTIAL_RESENT // 부분입고 재발송 (거래처에 잔량 재요청)
  PARTIAL_REACCEPTED // 부분입고 수락 (거래처가 재요청 수락)
  PARTIAL_COMPLETED // 부분입고 완료 (부분입고 후 모두 받음, 이력 보존)
  RECEIVED // 정상 입고완료 (한 번에 모두 받음)
  CLOSED // 부분입고 종결 (잔량 포기)
  CANCELLED
}

model PurchaseOrder {
  id                 String              @id @default(uuid())
  poNo               String              @unique @map("po_no")
  supplierId         String              @map("supplier_id")
  supplier           Supplier            @relation(fields: [supplierId], references: [id])
  status             PurchaseOrderStatus @default(DRAFT)
  orderDate          DateTime            @map("order_date")
  expectedDate       DateTime?           @map("expected_date")
  totalAmount        Decimal             @default(0) @map("total_amount") @db.Decimal(15, 2)
  memo               String?
  // 출고 정보(2026-05-23 도입). PICKUP 은 우리가 PO 발송 시 사전 설정 — 외부 페이지에서 거래처는 변경 불가.
  // 그 외 4종(COURIER/DIRECT_DELIVERY/QUICK_OR_CARGO/OTHER_SUPPLIER)은 거래처가 [수락] 모달에서 선택.
  shippingMethod     ShippingMethod?     @map("shipping_method")
  // 거래처가 약속한 납기일(PICKUP 인 경우 "출고 가능일"). [수락] 시 입력.
  promisedDate       DateTime?           @map("promised_date")
  // 송장번호 / 직접배달 시간대 / 외부 운송사명 등 자유 메모.
  shippingMemo       String?             @map("shipping_memo")
  // 가격 미정 라인이 있을 때 거래처가 [수락] 모달에서 단가를 직접 입력 — 이때 우리쪽 확인 필요 여부.
  // false (기본): 거래처 입력 즉시 CONFIRMED. true: 거래처 입력 → COUNTER_OFFER → 우리 검토 후 수락.
  requirePriceReview Boolean             @default(false) @map("require_price_review")
  // 발주가 매입견적서를 기반으로 작성된 경우
  quotationId        String?             @map("quotation_id")
  quotation          Quotation?          @relation(fields: [quotationId], references: [id])
  createdById        String              @map("created_by_id")
  createdBy          User                @relation(fields: [createdById], references: [id])
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")

  items        PurchaseOrderItem[]
  incomings    Incoming[]
  accessTokens PurchaseOrderAccessToken[]

  @@index([supplierId, orderDate])
  @@index([status])
  @@map("purchase_orders")
}

enum ShippingMethod {
  COURIER // 택배 출고 (CJ·한진·우체국 등)
  DIRECT_DELIVERY // 직접 배달 (거래처 차량으로 매장 배송)
  QUICK_OR_CARGO // 퀵·용달 (외부 운송사)
  OTHER_SUPPLIER // 다른 거래처 출고 (재고 부족 시 타 거래처에서 출고)
  PICKUP // 매장 직접 수령 (우리가 PO 발송 시 사전 선택)
}

// 거래처가 [수락] 시 라인별로 줄 수 있는 출고 응답.
// 기본 NORMAL — 라인별 분기를 사용하지 않으면 모든 라인이 NORMAL.
enum POLineFulfillmentStatus {
  NORMAL // 정상 (PO 납기일 기준)
  OUT_OF_STOCK // 재고 없음 (이번 발주에서 제외, 매장이 별도 결정)
  DELAYED // 지연 (lineDelayedDate 에 라인별 약속 납기)
}

enum ProposalStatus {
  NONE // 협상 없음 (기본)
  PENDING // 거래처 제안, 우리 응답 대기
  ACCEPTED // 우리가 수락 (proposedUnitPrice → unitPrice 적용됨)
  REJECTED // 우리가 거절 (proposedUnitPrice 보존, 단가 미적용)
}

enum POAccessTokenStatus {
  ACTIVE // 발급됨, 미사용
  VIEWED // 거래처가 한 번 이상 봤음
  ACCEPTED // 수락됨 (terminal)
  REJECTED // 거절됨 (terminal)
  EXPIRED // 만료
  REVOKED // 재발송으로 폐기
}

// 거래처가 ERP 계정 없이 발주 내용 확인 + 수락/거절 할 수 있는 외부 접근 토큰.
// - 토큰: crypto.randomBytes(32).toString("base64url") 256bit
// - 단방향: 한번 ACCEPTED/REJECTED 되면 재사용 불가
// - 재발송 시 새 row 생성, 이전 토큰은 REVOKED (이력 보존)
model PurchaseOrderAccessToken {
  id              String              @id @default(uuid())
  purchaseOrderId String              @map("purchase_order_id")
  purchaseOrder   PurchaseOrder       @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  token           String              @unique
  status          POAccessTokenStatus @default(ACTIVE)
  expiresAt       DateTime            @map("expires_at")
  issuedAt        DateTime            @default(now()) @map("issued_at")
  firstViewedAt   DateTime?           @map("first_viewed_at")
  lastViewedAt    DateTime?           @map("last_viewed_at")
  viewCount       Int                 @default(0) @map("view_count")
  acceptedAt      DateTime?           @map("accepted_at")
  rejectedAt      DateTime?           @map("rejected_at")
  rejectionNote   String?             @map("rejection_note")
  viewerIp        String?             @map("viewer_ip")
  viewerUserAgent String?             @map("viewer_user_agent")

  @@index([purchaseOrderId, status])
  @@index([expiresAt])
  @@map("purchase_order_access_tokens")
}

model PurchaseOrderItem {
  id                    String                  @id @default(uuid())
  purchaseOrderId       String                  @map("purchase_order_id")
  purchaseOrder         PurchaseOrder           @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  // 자유입력 라인 도입(2026-05-23) — 입고 전까지 거래처 공급상품을 특정할 수 없을 때
  // supplierProductId 없이 name 만으로 발주 가능. 입고 시 SupplierProductCombobox 로 매핑.
  // 둘 중 하나는 반드시 존재해야 함 (API 검증).
  supplierProductId     String?                 @map("supplier_product_id")
  supplierProduct       SupplierProduct?        @relation(fields: [supplierProductId], references: [id])
  // 자유입력 라인의 품명. supplierProductId 있으면 supplierProduct.name 우선 (override 용 보조 필드는 아님).
  name                  String?
  // 가격 미정 플래그(2026-05-23). true 면 외부 발주서에서 ₩0 대신 "가격 미정" 으로 표시되고
  // [수락] 버튼이 숨겨져 거래처가 반드시 [단가 변경 요청] 으로 가격 제안하게 강제.
  // 우리가 단가 수락하면 unitPrice 갱신 + priceUndetermined=false + PO 가 SENT 로 회귀.
  priceUndetermined     Boolean                 @default(false) @map("price_undetermined")
  // 거래처 라인별 출고 응답(2026-05-25 도입). [수락] 모달에서 "라인별로 다르게" 선택 시 설정.
  // NORMAL: 정상 (PO 납기일 기준)
  // OUT_OF_STOCK: 재고 없음 — 입고 prefill 에서 스킵, 매장이 별도 결정 ([발주 종료]/타 거래처 재발주)
  // DELAYED: 지연 — lineDelayedDate 에 약속 납기 저장, 입고 워크보드에서 따로 노출
  lineStatus            POLineFulfillmentStatus @default(NORMAL) @map("line_status")
  lineDelayedDate       DateTime?               @map("line_delayed_date")
  quantity              Decimal                 @db.Decimal(15, 4)
  // 분할 입고 누적 수량. quantity 도달 시 PurchaseOrder.status 가 RECEIVED 로 자동 전환.
  // 사용자가 "발주 종료" 누르면 잔량 무시하고 CLOSED.
  receivedQty           Decimal                 @default(0) @map("received_qty") @db.Decimal(15, 4)
  unitPrice             Decimal                 @map("unit_price") @db.Decimal(15, 2)
  totalPrice            Decimal                 @map("total_price") @db.Decimal(15, 2)
  // 거래처가 토큰 페이지에서 제안한 새 단가.
  // 수락 시 unitPrice 로 옮기되 proposedUnitPrice 는 보존 (이력 표시용).
  // 거절 시에도 보존. 새 제안이 들어오면 덮어쓰여짐 (단일 라운드 추적).
  proposedUnitPrice     Decimal?                @map("proposed_unit_price") @db.Decimal(15, 2)
  proposalStatus        ProposalStatus          @default(NONE) @map("proposal_status")
  proposalRespondedAt   DateTime?               @map("proposal_responded_at")
  proposalRejectionNote String?                 @map("proposal_rejection_note")
  memo                  String?
  sortOrder             Int                     @default(0) @map("sort_order")

  incomingItems IncomingItem[]

  @@map("purchase_order_items")
}

// ============================================================
// 주문 관리
// ============================================================

enum OrderStatus {
  PENDING // 주문/접수 — channelId 있으면 "주문"(외부), 없으면 "접수"(매장). 재고 미차감
  PREPARING // 출고대기 — 재고 차감됨, 포장·송장 발급 전. 취소 가능 마지막 단계
  PREPARING_PACKED // 출고확정 — 포장·송장 입력 완료, 발송 직전. 취소 불가 (반품 흐름으로)
  SHIPPED // 배송중 — 택배 인계 / 배달 출발
  COMPLETED // 배송완료 — 인도 종결
  RETURN_REQUESTED // 클레임 요청 — claimType 으로 반품/교환 분기. 매장 수락/반려 결정 전
  RETURN_ACCEPTED // 클레임 수락 — 회수대기 (택배 회수 라벨 발급 전)
  RETURN_PICKING // 회수중 — 택배 회수 라벨 발급됨, 손님→매장 운송 중
  RETURN_COLLECTED // 회수완료 — 물품 도착, 검수 전
  RETURN_INSPECTED // 검수완료 — 다음에 환불(반품) 또는 교환출고로 분기
  RETURNED // 반품완료 — 재고 복원 + 환불(또는 매출 취소) 종결
  EXCHANGED // 교환완료 — 재고 복원 + 새 주문(-EX) 자동 생성. 차액 정산은 새 주문에서
  CANCELLED
}

/**
 * 결제 축 — 출고 상태(OrderStatus) 와 별개의 재무 상태.
 * - UNPAID: 미수 (외상). UNPAID 인 채로 출고는 가능하지만 customer ledger 에 잔액 누적
 * - PAID: 결제 완료
 * - REFUND_PENDING: 환불 진행 중 (검수 후 PG/은행 처리 대기)
 * - PARTIAL_REFUND: 일부 환불 (부분 반품 시)
 * - REFUNDED: 전액 환불 완료
 * - SALES_CANCELLED: 매출 취소 — 외상(UNPAID) 주문 반품. 환불 없이 customer ledger 잔액 차감
 */
enum OrderPaymentStatus {
  UNPAID
  PAID
  PARTIAL_PAID // 부분 결제 — 일부 즉시 결제 + 잔액 미수금 (계약금/일부결제 케이스)
  REFUND_PENDING
  PARTIAL_REFUND
  REFUNDED
  SALES_CANCELLED
}

/**
 * 부분 결제 구분 — paymentStatus=PARTIAL_PAID 일 때만 의미.
 * - DEPOSIT: 계약금 (영수증·증명서에 "계약금" 라벨로 출력)
 * - PARTIAL: 일반 일부 결제 ("부분결제 영수증" 으로 출력)
 */
enum PartialPaymentKind {
  DEPOSIT
  PARTIAL
}

/**
 * 클레임 종류 — 손님이 어떤 결과를 원하는지. 회수 후 처리 분기.
 * - REFUND:             환불 종결 (RETURNED)
 * - EXCHANGE_SAME:      같은 상품 재발송. 새 주문 자동 생성 (항목 복제, totalAmount=0)
 * - EXCHANGE_DIFFERENT: 다른 상품으로 교체. 새 주문 자동 생성 (빈 항목, 사용자 편집 + 차액 정산)
 */
enum OrderClaimType {
  REFUND
  EXCHANGE_SAME
  EXCHANGE_DIFFERENT
}

/**
 * 클레임 사유 — 책임 소재 구분. 통계·정책(운임 부담 등)에 활용.
 * - DEFECTIVE:          불량/하자 — 매장 책임
 * - DAMAGED_IN_TRANSIT: 배송 중 파손 — 매장/택배사 책임
 * - WRONG_ITEM:         오배송 — 매장 책임
 * - CHANGE_MIND:        단순 변심 — 손님 책임
 * - SIZE_COLOR:         사이즈/색상 변경 — 부분 손님 책임
 * - OTHER:              기타
 */
enum OrderClaimReason {
  DEFECTIVE
  DAMAGED_IN_TRANSIT
  WRONG_ITEM
  CHANGE_MIND
  SIZE_COLOR
  OTHER
}

enum FulfillmentType {
  IN_STORE // 매장 즉시판매 (POS 결제 + 즉시 인도, 워크보드 미노출)
  PICKUP // 매장 픽업 대기 (결제 후 추후 방문 수령, 워크보드 노출)
  DELIVERY // 자체 배달 (매장 직원·차량, 당일·근거리)
  QUICK // 퀵 호출 (외부 퀵 업체 — 접수번호·퀵비 매장 부담)
  SHIPPING // 택배 발송 (외부 택배사 + 송장번호)
}

/**
 * 배송비 결제 방식 — Order.shippingPaymentType.
 * - PREPAID: 선불 (손님이 결제 시 함께 결제)
 * - COD: 착불 (받는 사람이 택배기사에게 직접 — 매장 회계 무관)
 * - STORE_BURDEN: 매장 부담 (배송비 무료, 매장 비용 처리)
 */
enum ShippingPaymentType {
  PREPAID
  COD
  STORE_BURDEN

  @@map("shipping_payment_type")
}

model Order {
  id                  String              @id @default(uuid())
  orderNo             String              @unique @map("order_no")
  channelId           String?             @map("channel_id")
  channel             SalesChannel?       @relation(fields: [channelId], references: [id])
  channelOrderNo      String?             @map("channel_order_no")
  status              OrderStatus         @default(PENDING)
  fulfillmentType     FulfillmentType     @default(IN_STORE) @map("fulfillment_type")
  expectedShipDate    DateTime?           @map("expected_ship_date") @db.Date
  customerId          String?             @map("customer_id")
  customer            Customer?           @relation(fields: [customerId], references: [id])
  /**
   * 등록 고객 스냅샷 — POS 결제 시 받는 사람과 다를 수 있어 별도 보존
   */
  customerName        String?             @map("customer_name")
  customerPhone       String?             @map("customer_phone")
  /**
   * 받는 사람 (배송 시) — 등록 고객(customerName)과 다를 수 있음. PICKUP 일 땐 null
   */
  recipientName       String?             @map("recipient_name")
  recipientPhone      String?             @map("recipient_phone")
  shippingAddress     String?             @map("shipping_address")
  /**
   * 최신 송장 캐시 (deprecated 예정) — 단일 송장 호환용 보존.
   * 실제 송장 정보는 `Shipment` 모델에 회차별로 저장. 마지막 회차의 송장이 여기 캐시됨.
   */
  trackingCarrier     String?             @map("tracking_carrier")
  trackingNumber      String?             @map("tracking_number")
  /**
   * 출고 회차 — partial_ship/ship 액션마다 +1. 1=일반 발송, ≥2=분할 발송. 분할 이력 표시용
   */
  shipmentCount       Int                 @default(0) @map("shipment_count")
  orderDate           DateTime            @map("order_date")
  quotationId         String?             @map("quotation_id")
  quotation           Quotation?          @relation(fields: [quotationId], references: [id])
  subtotalAmount      Decimal             @default(0) @map("subtotal_amount") @db.Decimal(15, 2)
  discountAmount      Decimal             @default(0) @map("discount_amount") @db.Decimal(15, 2)
  shippingFee         Decimal             @default(0) @map("shipping_fee") @db.Decimal(15, 2)
  /**
   * 배송비 결제 방식:
   * - PREPAID: 선불 (손님이 결제 시 함께 — 자사몰/일반 POS 택배)
   * - COD: 착불 (받는 사람이 택배기사에게 — 가구 등 대형 상품)
   * - STORE_BURDEN: 매장 부담 (배송비 무료 — 도매·VIP 등)
   * PICKUP fulfillmentType 은 배송비 자체가 무관 (default PREPAID 두되 무시).
   */
  shippingPaymentType ShippingPaymentType @default(PREPAID) @map("shipping_payment_type")
  /**
   * 배송 원가 (매장 지불) — 이 주문 출고에 매장이 실제로 지불한 퀵비·택배비.
   * shippingFee(손님에게 청구) 와 별개. 마진 리포트가 이 값을 순익에서 차감.
   */
  shippingCostBorne   Decimal             @default(0) @map("shipping_cost_borne") @db.Decimal(15, 2)
  taxAmount           Decimal             @default(0) @map("tax_amount") @db.Decimal(15, 2)
  totalAmount         Decimal             @default(0) @map("total_amount") @db.Decimal(15, 2)
  commissionAmount    Decimal             @default(0) @map("commission_amount") @db.Decimal(15, 2)
  paymentMethod       OrderPaymentMethod? @map("payment_method")
  /**
   * 결제 축 — 출고 상태와 별개. 외상/환불 표현용
   */
  paymentStatus       OrderPaymentStatus  @default(UNPAID) @map("payment_status")
  /**
   * 즉시 결제된 금액 — 부분 결제(PARTIAL_PAID) 케이스에 사용.
   * null/totalAmount 와 같으면 전액 결제(PAID), 0 이면 외상(UNPAID), 그 외는 PARTIAL_PAID.
   * 잔금 = totalAmount - paidAmount → customerLedger SALE 로 등록.
   */
  paidAmount          Decimal?            @map("paid_amount") @db.Decimal(15, 2)
  /**
   * 부분 결제 구분 — paymentStatus=PARTIAL_PAID 일 때만 의미.
   * 영수증·증명서 출력 시 "계약금"/"부분결제" 라벨 분기에 사용.
   */
  partialPaymentKind  PartialPaymentKind? @map("partial_payment_kind")
  /**
   * 반품 흐름 timestamp — 운영 로그 + 단계 추적
   */
  returnRequestedAt   DateTime?           @map("return_requested_at")
  returnAcceptedAt    DateTime?           @map("return_accepted_at")
  returnRejectedAt    DateTime?           @map("return_rejected_at")
  /**
   * 클레임 분기 — 환불/같은상품교환/다른상품교환. RETURN_REQUESTED 시 결정.
   */
  claimType           OrderClaimType?     @map("claim_type")
  claimReason         OrderClaimReason?   @map("claim_reason")
  /**
   * 교환 종결 시 새 주문 link — 차액 정산은 새 주문에서
   */
  exchangeOrderId     String?             @unique @map("exchange_order_id")
  exchangeOrder       Order?              @relation("OrderExchange", fields: [exchangeOrderId], references: [id])
  exchangedFromOrders Order[]             @relation("OrderExchange")
  exchangedAt         DateTime?           @map("exchanged_at")
  // 분할 출고 — 한 결제가 매장수령(대표)/택배(백오더) 등으로 갈릴 때 연결 (docs/SPLIT_FULFILLMENT.md)
  splitGroupId        String?             @map("split_group_id")
  splitParentId       String?             @map("split_parent_id")
  splitParent         Order?              @relation("OrderSplit", fields: [splitParentId], references: [id])
  splitChildren       Order[]             @relation("OrderSplit")
  /**
   * 클레임 메모 — 손님 자유 사유 + 매장 처리 메모 (claimReason enum 외 보충)
   */
  returnReason        String?             @map("return_reason")
  taxInvoiceRequested Boolean             @default(false) @map("tax_invoice_requested")
  taxInvoicedAt       DateTime?           @map("tax_invoiced_at")
  memo                String?
  // 한 RepairTicket / Rental 은 결제 Order 1건만 가질 수 있음 (1:1).
  // application-level idempotency 외에 DB 차원에서도 강제 — 미래 흐름 추가 시 안전망.
  // 한 Order 에 수리 여러 건 link 가능 (N:1, RepairTicket.orderId 가 fk)
  repairTickets       RepairTicket[]
  rentalId            String?             @unique @map("rental_id")
  rental              Rental?             @relation(fields: [rentalId], references: [id])
  createdById         String              @map("created_by_id")
  createdBy           User                @relation(fields: [createdById], references: [id])
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")

  items      OrderItem[]
  shipments  Shipment[]
  statements Statement[]
  refunds    CustomerRefund[]

  // 채널 import 중복 방지 — 동일 채널 내 channelOrderNo 는 한 번만 import.
  // PostgreSQL 의 unique 는 NULL 을 unique 로 보지 않으므로 오프라인(channelId=null) 주문은 영향 X.
  @@unique([channelId, channelOrderNo])
  @@index([channelId, orderDate])
  @@index([status])
  @@index([status, expectedShipDate])
  @@index([splitGroupId])
  // repairTicketId / rentalId 는 @unique 가 자동으로 unique index 생성 — 별도 @@index 불필요
  @@map("orders")
}

model OrderItem {
  id                            String            @id @default(uuid())
  orderId                       String            @map("order_id")
  order                         Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId                     String?           @map("product_id")
  product                       Product?          @relation(fields: [productId], references: [id])
  canonicalProductId            String?           @map("canonical_product_id")
  serviceName                   String?           @map("service_name")
  quantity                      Decimal           @db.Decimal(15, 4)
  /**
   * 정가(할인 전 단가, 세전) — 견적서/거래명세표 → 주문 전환 시 보존
   */
  listPrice                     Decimal?          @map("list_price") @db.Decimal(15, 2)
  /**
   * 개당 할인액 (세전)
   */
  discountAmount                Decimal?          @map("discount_amount") @db.Decimal(15, 2)
  unitPrice                     Decimal           @map("unit_price") @db.Decimal(15, 2)
  totalPrice                    Decimal           @map("total_price") @db.Decimal(15, 2)
  unitCostSnapshot              Decimal?          @map("unit_cost_snapshot") @db.Decimal(15, 4)
  channelCommissionRateSnapshot Decimal?          @map("channel_commission_rate_snapshot") @db.Decimal(5, 4)
  cardFeeRateSnapshot           Decimal?          @map("card_fee_rate_snapshot") @db.Decimal(5, 4)
  sellingCostSnapshot           Decimal?          @map("selling_cost_snapshot") @db.Decimal(15, 4)
  /**
   * 부분 출고/반품/환불 추적 — 항목 단위 누적값.
   * - shippedQty:    누적 발송 수량 (≤ quantity). 부분 출고 후 추가 발송으로 누적
   * - returnedQty:   누적 반품 수량 (≤ quantity). 부분 반품 누적
   * - refundedAmount: 누적 환불 금액 (세전). totalPrice 와 비교해 전액/부분 판정
   */
  shippedQty                    Decimal           @default(0) @map("shipped_qty") @db.Decimal(15, 4)
  returnedQty                   Decimal           @default(0) @map("returned_qty") @db.Decimal(15, 4)
  refundedAmount                Decimal           @default(0) @map("refunded_amount") @db.Decimal(15, 2)
  /**
   * 라인 역할 — MAIN(기본·variant 라인), OPTION_REF(메인의 옵션으로 매핑된 별도 Product), ADDON(추가상품, 후속).
   * parentItemId 와 함께 사용 — 메인-옵션/추가구매 트리 표현.
   */
  lineRole                      OrderItemLineRole @default(MAIN) @map("line_role")
  parentItemId                  String?           @map("parent_item_id")
  parentItem                    OrderItem?        @relation("OrderItemParent", fields: [parentItemId], references: [id], onDelete: SetNull)
  childItems                    OrderItem[]       @relation("OrderItemParent")
  /**
   * 주문 시점 옵션값 스냅샷 — Product.option/value 가 미래에 변경되어도 보존.
   * 형식: { "메모리": "32GB", "색상": "화이트" }
   * MAIN 라인의 경우 그 라인이 가진 옵션 조합. OPTION_REF 라인은 보통 비어있음 (parentItemId 가 메인 가리킴).
   */
  optionSnapshot                Json?             @map("option_snapshot")
  /**
   * 진입 경로 SKU (B2C funnel 분석용) — 손님이 카탈로그에서 본 SKU.
   * SWAP 옵션 적용 후 productId 가 다른 SKU 로 바뀌므로 진입 페이지 별도 보존.
   * 정책:
   * - POS: null (직원이 직접 입력 — 손님 의향과 무관, 노이즈 회피)
   * - 자사몰/외부 채널 import: 카탈로그 진입 SKU (보통 OPTION_PARENT 또는 cross-sell 시작점)
   * 분석 쿼리는 IS NOT NULL 로 필터해 자사몰/채널 데이터만 집계.
   */
  entryProductId                String?           @map("entry_product_id")
  entryProduct                  Product?          @relation("OrderItemEntry", fields: [entryProductId], references: [id], onDelete: SetNull)
  /**
   * 서비스로 지급된 라인 — unitPrice=0 + 매장이 손님에게 무상 제공.
   * 영수증·명세표·통합판매내역에서 "서비스" 배지로 명시. 마진 리포트는 listPrice 기준으로
   * 서비스 부피 별도 집계 가능.
   */
  isService                     Boolean           @default(false) @map("is_service")
  memo                          String?

  lotConsumptions LotConsumption[]
  serialItems     SerialItem[]
  shipmentItems   ShipmentItem[]
  // 단품 판매된 UsedItem 역방향 (1:1). null 이면 일반 신품 판매.
  soldUsedItem    UsedItem?

  @@index([parentItemId])
  @@index([entryProductId])
  @@map("order_items")
}

enum OrderItemLineRole {
  MAIN
  OPTION_REF
  ADDON
}

// ============================================================
// 분할 송장 — 한 주문이 여러 회차에 걸쳐 발송될 때 회차별 송장 보관
// ============================================================
//
// 한국 오픈마켓 (네이버·쿠팡·11번가·G마켓) 의 표준 패턴. 한 주문의 여러 OrderItem 을
// 하나의 송장으로 묶거나, 한 OrderItem 을 여러 송장으로 쪼개 보낼 수도 있음.
//
// 정책:
//   - Order.trackingCarrier/Number 는 "최신 송장 캐시" 로 보존 (deprecated 진행 중).
//     여러 회차 중 가장 최근 Shipment 의 송장이 cache 에 채워짐.
//   - shipmentNo 는 같은 order 안에서 1부터 증가. 첫 발송=1, 두 번째=2.
//   - ship/partial_ship 액션 시 Shipment 1건 + 발송된 OrderItem 의 quantity 만큼 ShipmentItem 생성
//   - 한 OrderItem 의 (Σ ShipmentItem.quantity) ≤ OrderItem.quantity 강제 (애플리케이션 레벨)

model Shipment {
  id              String   @id @default(uuid())
  orderId         String   @map("order_id")
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  /**
   * 같은 주문 안에서 1부터 증가 (1차·2차·3차 발송)
   */
  shipmentNo      Int      @map("shipment_no")
  trackingCarrier String?  @map("tracking_carrier")
  trackingNumber  String?  @map("tracking_number")
  shippedAt       DateTime @map("shipped_at")
  memo            String?
  createdAt       DateTime @default(now()) @map("created_at")

  items ShipmentItem[]

  @@unique([orderId, shipmentNo])
  @@index([orderId, shippedAt])
  @@map("shipments")
}

model ShipmentItem {
  id          String    @id @default(uuid())
  shipmentId  String    @map("shipment_id")
  shipment    Shipment  @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  orderItemId String    @map("order_item_id")
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  /**
   * 이 회차에 발송한 수량 (라인의 일부 수량 가능)
   */
  quantity    Decimal   @db.Decimal(15, 4)

  @@index([orderItemId])
  @@map("shipment_items")
}

// ============================================================
// 로트 기반 재고 추적 (FIFO)
// ============================================================

enum LotSource {
  INCOMING
  INITIAL
  ADJUSTMENT
  SET_PRODUCE
}

model InventoryLot {
  id                String           @id @default(uuid())
  productId         String?          @map("product_id")
  product           Product?         @relation(fields: [productId], references: [id])
  supplierProductId String?          @map("supplier_product_id")
  supplierProduct   SupplierProduct? @relation(fields: [supplierProductId], references: [id])
  receivedQty       Decimal          @map("received_qty") @db.Decimal(15, 4)
  remainingQty      Decimal          @map("remaining_qty") @db.Decimal(15, 4)
  unitCost          Decimal          @map("unit_cost") @db.Decimal(15, 4)
  originalPrice     Decimal?         @map("original_price") @db.Decimal(15, 4)
  discountAmount    Decimal?         @map("discount_amount") @db.Decimal(15, 4)
  receivedAt        DateTime         @map("received_at")
  source            LotSource
  incomingItemId    String?          @map("incoming_item_id")
  incomingItem      IncomingItem?    @relation(fields: [incomingItemId], references: [id])
  memo              String?
  createdAt         DateTime         @default(now()) @map("created_at")

  consumptions LotConsumption[]

  @@index([productId, receivedAt])
  @@index([supplierProductId, receivedAt])
  @@index([incomingItemId])
  @@map("inventory_lots")
}

model LotConsumption {
  id           String       @id @default(uuid())
  orderItemId  String?      @map("order_item_id")
  orderItem    OrderItem?   @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  repairPartId String?      @map("repair_part_id")
  repairPart   RepairPart?  @relation(fields: [repairPartId], references: [id], onDelete: Cascade)
  lotId        String       @map("lot_id")
  lot          InventoryLot @relation(fields: [lotId], references: [id])
  quantity     Decimal      @db.Decimal(15, 4)
  unitCost     Decimal      @map("unit_cost") @db.Decimal(15, 4)
  createdAt    DateTime     @default(now()) @map("created_at")

  @@index([orderItemId])
  @@index([repairPartId])
  @@index([lotId])
  @@map("lot_consumptions")
}

// ============================================================
// 반품 관리
// ============================================================

enum ReturnStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

model SupplierReturn {
  id                  String       @id @default(uuid())
  returnNo            String       @unique @map("return_no")
  supplierId          String       @map("supplier_id")
  supplier            Supplier     @relation(fields: [supplierId], references: [id])
  status              ReturnStatus @default(PENDING)
  returnDate          DateTime     @map("return_date")
  returnReason        String?      @map("return_reason")
  memo                String?
  returnCost          Decimal?     @map("return_cost") @db.Decimal(12, 2)
  returnCostIsTaxable Boolean      @default(true) @map("return_cost_is_taxable")
  returnCostType      String?      @map("return_cost_type") // ADD | DEDUCT | SEPARATE
  returnCostNote      String?      @map("return_cost_note")
  exchangeIncomingId  String?      @unique @map("exchange_incoming_id")
  exchangeIncoming    Incoming?    @relation(fields: [exchangeIncomingId], references: [id])
  createdById         String       @map("created_by_id")
  createdBy           User         @relation(fields: [createdById], references: [id])
  createdAt           DateTime     @default(now()) @map("created_at")
  updatedAt           DateTime     @updatedAt @map("updated_at")

  items SupplierReturnItem[]

  @@index([supplierId, returnDate])
  @@map("supplier_returns")
}

model SupplierReturnItem {
  id                String          @id @default(uuid())
  returnId          String          @map("return_id")
  return            SupplierReturn  @relation(fields: [returnId], references: [id], onDelete: Cascade)
  supplierProductId String          @map("supplier_product_id")
  supplierProduct   SupplierProduct @relation(fields: [supplierProductId], references: [id])
  quantity          Decimal         @db.Decimal(15, 4)
  unitPrice         Decimal         @map("unit_price") @db.Decimal(15, 2)
  totalPrice        Decimal         @map("total_price") @db.Decimal(15, 2)
  memo              String?

  @@map("supplier_return_items")
}

// ============================================================
// 카드수수료율
// ============================================================

model CardFeeRate {
  id          String   @id @default(uuid())
  rate        Decimal  @db.Decimal(5, 4)
  memo        String?
  appliedFrom DateTime @map("applied_from")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("card_fee_rates")
}

// ============================================================
// 가맹점 카드사별 수수료 정보 (참고용 + 평균 산출 소스)
// ============================================================

model CardMerchantInfo {
  id           String    @id @default("singleton")
  merchantTier String?   @map("merchant_tier")
  appliedFrom  DateTime? @map("applied_from")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@map("card_merchant_info")
}

model CardCompanyFee {
  id                String   @id @default(uuid())
  companyName       String   @map("company_name")
  merchantNo        String?  @map("merchant_no")
  settlementBank    String?  @map("settlement_bank")
  settlementAccount String?  @map("settlement_account")
  creditRate        Decimal  @map("credit_rate") @db.Decimal(5, 4)
  checkBankRate     Decimal? @map("check_bank_rate") @db.Decimal(5, 4)
  checkSpecialRate  Decimal? @map("check_special_rate") @db.Decimal(5, 4)
  paymentDays       Int?     @map("payment_days")
  sortOrder         Int      @default(0) @map("sort_order")
  isActive          Boolean  @default(true) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@index([sortOrder])
  @@map("card_company_fees")
}

// ============================================================
// 우리 사업자 정보 / 통장
// ============================================================

model CompanyInfo {
  id                          String   @id @default("singleton")
  name                        String
  businessNumber              String?  @map("business_number")
  ceo                         String?
  phone                       String?
  email                       String?
  address                     String?
  businessType                String?  @map("business_type")
  businessItem                String?  @map("business_item")
  defaultRepairWarrantyMonths Int?     @map("default_repair_warranty_months") // 수리 보증 기본값 (개월)
  defaultDiagnosisFee         Decimal? @map("default_diagnosis_fee") @db.Decimal(15, 2) // 새 수리 접수 시 자동 채울 진단비
  allowNegativeStock          Boolean  @default(true) @map("allow_negative_stock") // 재고 부족 시에도 판매 허용 (음수 재고 — 추후 재고조정으로 정산)
  updatedAt                   DateTime @updatedAt @map("updated_at")

  bankAccounts CompanyBankAccount[]

  @@map("company_info")
}

// 모든 상품 상세페이지에 자동으로 attach 되는 공통 header/footer 블록
// header: product-hero 등 페이지 최상단 영역 (모든 상품 공통 디자인)
// footer: 배송/환불/AS 안내 등
model LandingSettings {
  id           String   @id @default("singleton")
  headerBlocks Json?    @map("header_blocks")
  footerBlocks Json?    @map("footer_blocks")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("landing_settings")
}

model CompanyBankAccount {
  id        String   @id @default(uuid())
  companyId String   @default("singleton") @map("company_id")
  bankName  String   @map("bank_name")
  holder    String
  account   String
  isPrimary Boolean  @default(false) @map("is_primary")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  company CompanyInfo @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, sortOrder])
  @@map("company_bank_accounts")
}

// ============================================================
// 고객 (Customer) — 판매 상대방
// ============================================================

enum CustomerType {
  INDIVIDUAL // 개인
  BUSINESS // 기업/사업자
}

model Customer {
  id                   String       @id @default(uuid())
  type                 CustomerType @default(INDIVIDUAL)
  // 공통: 개인=이름, 기업=상호
  name                 String
  phone                String
  email                String?
  memo                 String?
  // 기업 전용 (type=BUSINESS 일 때 의미)
  businessNumber       String?      @map("business_number")
  ceo                  String? // 대표자명
  fax                  String?
  businessType         String?      @map("business_type") // 업태
  businessItem         String?      @map("business_item") // 종목
  // 주소 — 사업장(기업)/기본(개인) + 배송지 (다를 때만 채움)
  address              String?
  shippingAddress      String?      @map("shipping_address")
  // 기업 담당자 (대표 외 실무 연락처) — 개인은 미사용
  contactName          String?      @map("contact_name")
  contactPhone         String?      @map("contact_phone")
  contactPosition      String?      @map("contact_position")
  isActive             Boolean      @default(true) @map("is_active")
  // 시리얼번호 기반 보증·수리·구매내역 조회 서비스 이용 동의 (PIPA)
  serialServiceConsent Boolean      @default(false) @map("serial_service_consent")
  consentedAt          DateTime?    @map("consented_at")
  consentVersion       String?      @map("consent_version") // 동의한 PrivacyPolicyVersion.id
  createdAt            DateTime     @default(now()) @map("created_at")
  updatedAt            DateTime     @updatedAt @map("updated_at")

  quotations       Quotation[]
  statements       Statement[]
  orders           Order[]
  ledger           CustomerLedger[]
  payments         CustomerPayment[]
  refunds          CustomerRefund[]
  machines         CustomerMachine[]
  notes            CustomerNote[]
  repairs          RepairTicket[]
  rentals          Rental[]
  expenses         Expense[]
  serialItems      SerialItem[]
  posSessions      PosSession[]
  usedItemsSourced UsedItem[]        @relation("UsedItemSourceCustomer")

  @@index([name])
  @@index([phone])
  @@index([businessNumber])
  @@index([type])
  @@map("customers")
}

enum CustomerLedgerType {
  SALE // 매출 (미수금 증가)
  RECEIPT // 수금 (미수금 감소)
  ADJUSTMENT
  REFUND // 환불 (미수금 증가)
}

model CustomerLedger {
  id            String             @id @default(uuid())
  customerId    String             @map("customer_id")
  customer      Customer           @relation(fields: [customerId], references: [id])
  date          DateTime           @default(now())
  type          CustomerLedgerType
  description   String
  debitAmount   Decimal            @default(0) @map("debit_amount") @db.Decimal(15, 2) // 매출/환불(증가)
  creditAmount  Decimal            @default(0) @map("credit_amount") @db.Decimal(15, 2) // 수금(감소)
  balance       Decimal            @map("balance") @db.Decimal(15, 2)
  referenceId   String?            @map("reference_id")
  referenceType String?            @map("reference_type")
  createdAt     DateTime           @default(now()) @map("created_at")

  @@index([customerId, date])
  @@map("customer_ledgers")
}

model CustomerPayment {
  id          String      @id @default(uuid())
  customerId  String      @map("customer_id")
  customer    Customer    @relation(fields: [customerId], references: [id])
  amount      Decimal     @db.Decimal(15, 2)
  paymentDate DateTime    @map("payment_date")
  method      String
  kind        PaymentKind @default(MIXED)
  memo        String?
  createdById String      @map("created_by_id")
  createdBy   User        @relation(fields: [createdById], references: [id])
  createdAt   DateTime    @default(now()) @map("created_at")

  @@index([customerId, paymentDate])
  @@map("customer_payments")
}

// ============================================================
// CustomerRefund — 고객에게 환불한 내역 (CustomerPayment 의 반대)
// 주문 반품/취소 시 RefundDialog 에서 입력. 같은 주문이 여러 번 부분 환불될 수 있어 1:N.
// CustomerLedger.REFUND 항목과 1:1 연결 (referenceType="CustomerRefund").
// ============================================================
enum CustomerRefundMethod {
  CARD_CANCEL // 카드 취소 (PG 환불 — Toss/PortOne)
  CASH // 현금
  BANK_TRANSFER // 계좌이체
  POINTS // 포인트/마일리지
  OTHER // 기타 (수표·상품권 회수 등)
}

model CustomerRefund {
  id          String               @id @default(uuid())
  customerId  String               @map("customer_id")
  customer    Customer             @relation(fields: [customerId], references: [id])
  orderId     String               @map("order_id")
  order       Order                @relation(fields: [orderId], references: [id])
  amount      Decimal              @db.Decimal(15, 2)
  method      CustomerRefundMethod
  refundedAt  DateTime             @map("refunded_at")
  memo        String?
  createdById String               @map("created_by_id")
  createdBy   User                 @relation(fields: [createdById], references: [id])
  createdAt   DateTime             @default(now()) @map("created_at")

  @@index([customerId, refundedAt])
  @@index([orderId])
  @@map("customer_refunds")
}

// ============================================================
// 견적서 (Quotation) — 판매/매입 통합
// ============================================================

enum QuotationType {
  SALES
  PURCHASE
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
  CONVERTED
}

model Quotation {
  id             String          @id @default(uuid())
  quotationNo    String          @unique @map("quotation_no")
  type           QuotationType
  status         QuotationStatus @default(DRAFT)
  issueDate      DateTime        @map("issue_date")
  validUntil     DateTime?       @map("valid_until")
  customerId     String?         @map("customer_id")
  customer       Customer?       @relation(fields: [customerId], references: [id])
  supplierId     String?         @map("supplier_id")
  supplier       Supplier?       @relation(fields: [supplierId], references: [id])
  title          String?
  subtotalAmount Decimal         @default(0) @map("subtotal_amount") @db.Decimal(15, 2)
  taxAmount      Decimal         @default(0) @map("tax_amount") @db.Decimal(15, 2)
  totalAmount    Decimal         @default(0) @map("total_amount") @db.Decimal(15, 2)
  memo           String?
  terms          String?
  createdById    String          @map("created_by_id")
  createdBy      User            @relation(fields: [createdById], references: [id])
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  items          QuotationItem[]
  orders         Order[]
  incomings      Incoming[]
  purchaseOrders PurchaseOrder[]
  statements     Statement[]

  @@index([type, issueDate])
  @@index([status])
  @@map("quotations")
}

model QuotationItem {
  id                String           @id @default(uuid())
  quotationId       String           @map("quotation_id")
  quotation         Quotation        @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  productId         String?          @map("product_id")
  product           Product?         @relation(fields: [productId], references: [id])
  supplierProductId String?          @map("supplier_product_id")
  supplierProduct   SupplierProduct? @relation(fields: [supplierProductId], references: [id])
  name              String
  spec              String?
  unitOfMeasure     String           @default("EA") @map("unit_of_measure")
  quantity          Decimal          @db.Decimal(15, 4)
  listPrice         Decimal          @default(0) @map("list_price") @db.Decimal(15, 2)
  discountAmount    Decimal          @default(0) @map("discount_amount") @db.Decimal(15, 2)
  unitPrice         Decimal          @map("unit_price") @db.Decimal(15, 2)
  totalPrice        Decimal          @map("total_price") @db.Decimal(15, 2)
  isTaxable         Boolean          @default(true) @map("is_taxable")
  sortOrder         Int              @default(0) @map("sort_order")
  memo              String?

  @@map("quotation_items")
}

// ============================================================
// 거래명세표 (Statement) — 판매용
// ============================================================

enum StatementStatus {
  DRAFT
  ISSUED
  CANCELLED
}

model Statement {
  id                             String          @id @default(uuid())
  statementNo                    String          @unique @map("statement_no")
  status                         StatementStatus @default(ISSUED)
  issueDate                      DateTime        @map("issue_date")
  customerId                     String?         @map("customer_id")
  customer                       Customer?       @relation(fields: [customerId], references: [id])
  customerNameSnapshot           String?         @map("customer_name_snapshot")
  customerPhoneSnapshot          String?         @map("customer_phone_snapshot")
  customerAddressSnapshot        String?         @map("customer_address_snapshot")
  customerBusinessNumberSnapshot String?         @map("customer_business_number_snapshot")
  orderId                        String?         @map("order_id")
  order                          Order?          @relation(fields: [orderId], references: [id])
  quotationId                    String?         @map("quotation_id")
  quotation                      Quotation?      @relation(fields: [quotationId], references: [id])
  subtotalAmount                 Decimal         @default(0) @map("subtotal_amount") @db.Decimal(15, 2)
  taxAmount                      Decimal         @default(0) @map("tax_amount") @db.Decimal(15, 2)
  totalAmount                    Decimal         @default(0) @map("total_amount") @db.Decimal(15, 2)
  memo                           String?
  createdById                    String          @map("created_by_id")
  createdBy                      User            @relation(fields: [createdById], references: [id])
  createdAt                      DateTime        @default(now()) @map("created_at")
  updatedAt                      DateTime        @updatedAt @map("updated_at")

  items StatementItem[]

  @@index([issueDate])
  @@map("statements")
}

model StatementItem {
  id             String    @id @default(uuid())
  statementId    String    @map("statement_id")
  statement      Statement @relation(fields: [statementId], references: [id], onDelete: Cascade)
  productId      String?   @map("product_id")
  product        Product?  @relation(fields: [productId], references: [id])
  name           String
  spec           String?
  unitOfMeasure  String    @default("EA") @map("unit_of_measure")
  quantity       Decimal   @db.Decimal(15, 4)
  listPrice      Decimal   @default(0) @map("list_price") @db.Decimal(15, 2)
  discountAmount Decimal   @default(0) @map("discount_amount") @db.Decimal(15, 2)
  unitPrice      Decimal   @map("unit_price") @db.Decimal(15, 2)
  totalPrice     Decimal   @map("total_price") @db.Decimal(15, 2)
  isTaxable      Boolean   @default(true) @map("is_taxable")
  sortOrder      Int       @default(0) @map("sort_order")
  memo           String?

  @@map("statement_items")
}

// ============================================================
// POS — 상품 미디어, 결제수단, 고객 보유 기계, 방문 메모
// ============================================================

enum ProductMediaType {
  IMAGE
  YOUTUBE
}

enum ProductMediaKind {
  THUMBNAIL // 1:1 정사각, 상품 카드/리스트 썸네일용
  DETAIL // 자유 비율, 상품 상세 페이지 슬라이드/디테일샷
}

model ProductMedia {
  id        String           @id @default(uuid())
  productId String           @map("product_id")
  product   Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  type      ProductMediaType
  kind      ProductMediaKind @default(THUMBNAIL)
  url       String
  title     String?
  sortOrder Int              @default(0) @map("sort_order")
  createdAt DateTime         @default(now()) @map("created_at")

  @@index([productId, sortOrder])
  @@map("product_media")
}

enum OrderPaymentMethod {
  CASH
  CASH_RECEIPT // 현금영수증 발행 — 손님 휴대폰/사업자번호로 국세청 영수증 발급된 현금 결제
  CARD
  TRANSFER
  MIXED
  UNPAID
}

model CustomerMachine {
  id            String    @id @default(uuid())
  customerId    String    @map("customer_id")
  customer      Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  productId     String?   @map("product_id")
  product       Product?  @relation(fields: [productId], references: [id])
  name          String
  brand         String?
  modelNo       String?   @map("model_no")
  serialNo      String?   @map("serial_no")
  purchasedAt   DateTime? @map("purchased_at")
  purchasedFrom String?   @map("purchased_from")
  memo          String?
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  repairs RepairTicket[]

  @@index([customerId])
  @@map("customer_machines")
}

model CustomerNote {
  id          String   @id @default(uuid())
  customerId  String   @map("customer_id")
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  content     String
  createdById String   @map("created_by_id")
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([customerId, createdAt])
  @@map("customer_notes")
}

// ============================================================
// 수리 (RepairTicket)
// ============================================================

enum RepairStatus {
  RECEIVED // 접수
  DIAGNOSING // 진단 중 (DROP_OFF만)
  QUOTED // 견적 안내 (DROP_OFF만)
  APPROVED // 손님 승인 (DROP_OFF만)
  REPAIRING // 수리 중
  READY // 완료, 픽업 대기
  PICKED_UP // 픽업/결제 완료
  CANCELLED // 거절(DECLINED)/취소 — 진단비만 청구
}

enum RepairApprovalMethod {
  ON_SITE
  REMOTE
}

enum RepairType {
  ON_SITE // 즉시수리 — POS 카트에서 받자마자 수리·결제
  DROP_OFF // 맡김수리 — 받아두고 며칠 내 수리 후 픽업
}

// 수리 작업의 성격 — RepairType(시간 축, ON_SITE/DROP_OFF) 와는 직교.
// REPAIR: 일반 수리 (기존 흐름, 기본값)
// CUSTOM_BUILD: 리빌드 — 손님 부품을 받아 추가 부속·공임으로 새 구성품 조립. 의미만 다르고 데이터 흐름은 RepairTicket 그대로.
enum RepairWorkKind {
  REPAIR
  CUSTOM_BUILD
}

enum RepairPartStatus {
  USED // 정상 사용 — 청구 포함
  LOST // 손실 (수리 실패·교체로 망가짐) — 청구 제외, 재고는 차감 유지 → 매출원가 손실
}

// 수리 취소 사유 — 분석/고객응대용
enum RepairCancelReason {
  CUSTOMER_DECLINED // 손님이 거절 — 진단비도 면제 (정상 거절은 quoteRejectReason 사용)
  CUSTOMER_NO_SHOW // 손님 미반환 (맡겼는데 안 찾으러 옴)
  SHOP_GAVE_UP // 매장 포기 (수리 불가 판정)
  PARTS_UNAVAILABLE // 부속 수급 불가
  SOLD_AS_PRODUCT // 수리 대신 상품 구매로 전환 (같은 또는 다른 제품) — 보존 가치 있음
  MISTAKE // 잘못 생성 (실수로 만든 티켓 — 진단·자료 무의미)
  OTHER // 기타 (cancelMemo 참조)
}

// 견적 거절 사유 — reject_after_quote 액션 (진단비만 청구) 시 기록.
// 손님 사유와 매장 사유 모두 포함 — 결과(진단비만 청구) 가 같음.
// cancel 흐름의 PARTS_UNAVAILABLE/SHOP_GAVE_UP 은 "진단비도 안 받음" 케이스라 별개.
enum QuoteRejectReason {
  // 손님 사유
  TOO_EXPENSIVE // 가격 부담 (수리비 자체가 비싸서)
  NOT_WORTH_IT // 가성비 문제 (새 제품 사는 게 나음)
  WILL_SHOP_AROUND // 다른 매장 비교 후 결정
  CHANGED_MIND // 단순 변심
  // 매장 사유
  PARTS_UNAVAILABLE // 부속 수급 불가 (진단까진 했는데 부속 못 구함)
  SHOP_DECLINED // 매장 포기 (장비·시간·복잡도 부족)
  OTHER // 기타 (quoteRejectMemo 참조)
}

model RepairTicket {
  id                     String                   @id @default(uuid())
  ticketNo               String                   @unique @map("ticket_no")
  type                   RepairType               @default(ON_SITE)
  // 작업 성격 — REPAIR(기본) / CUSTOM_BUILD(리빌드). RepairType 과 직교.
  workKind               RepairWorkKind           @default(REPAIR) @map("work_kind")
  customerId             String?                  @map("customer_id")
  customer               Customer?                @relation(fields: [customerId], references: [id])
  customerMachineId      String?                  @map("customer_machine_id")
  customerMachine        CustomerMachine?         @relation(fields: [customerMachineId], references: [id])
  serialItemId           String?                  @map("serial_item_id")
  serialItem             SerialItem?              @relation(fields: [serialItemId], references: [id], onDelete: SetNull)
  status                 RepairStatus             @default(RECEIVED)
  receivedAt             DateTime                 @map("received_at")
  /**
   * 증상 — 자유 텍스트 (display 용, 그대로 보존). 콤보박스에서 선택했으면 symptomTemplateId 도 함께 설정됨.
   * 직접 입력 시엔 자동으로 template 생성 + ID 연결 (PUT API hook 에서 처리).
   */
  symptom                String?
  symptomTemplateId      String?                  @map("symptom_template_id")
  symptomTemplate        RepairSymptomTemplate?   @relation(fields: [symptomTemplateId], references: [id], onDelete: SetNull)
  diagnosis              String?
  diagnosisTemplateId    String?                  @map("diagnosis_template_id")
  diagnosisTemplate      RepairDiagnosisTemplate? @relation(fields: [diagnosisTemplateId], references: [id], onDelete: SetNull)
  repairNotes            String?                  @map("repair_notes")
  // 가져온 기기 정보 — 시리얼/판매상품 카탈로그에 없을 때 자유 입력 fallback
  repairProductId        String?                  @map("repair_product_id")
  repairProduct          Product?                 @relation("RepairProduct", fields: [repairProductId], references: [id], onDelete: SetNull)
  repairProductText      String?                  @map("repair_product_text") // 카탈로그에 없을 때 자유 입력 (예: "Sony A7M4 Black")
  diagnosisFee           Decimal                  @default(0) @map("diagnosis_fee") @db.Decimal(15, 2)
  totalDiscount          String                   @default("0") @map("total_discount") // "1000" or "10%"
  quotedLaborAmount      Decimal                  @default(0) @map("quoted_labor_amount") @db.Decimal(15, 2)
  quotedPartsAmount      Decimal                  @default(0) @map("quoted_parts_amount") @db.Decimal(15, 2)
  quotedTotalAmount      Decimal                  @default(0) @map("quoted_total_amount") @db.Decimal(15, 2)
  quotedAt               DateTime?                @map("quoted_at")
  approvalMethod         RepairApprovalMethod?    @map("approval_method")
  approvalToken          String?                  @unique @map("approval_token")
  approvalTokenExpiresAt DateTime?                @map("approval_token_expires_at")
  approvedAt             DateTime?                @map("approved_at")
  approvedByName         String?                  @map("approved_by_name")
  startedAt              DateTime?                @map("started_at")
  readyAt                DateTime?                @map("ready_at")
  pickedUpAt             DateTime?                @map("picked_up_at")
  finalAmount            Decimal                  @default(0) @map("final_amount") @db.Decimal(15, 2)
  paymentMethod          OrderPaymentMethod?      @map("payment_method")
  // 수리 보증 — 픽업(완료) 시점부터 시작
  repairWarrantyMonths   Int?                     @map("repair_warranty_months")
  repairWarrantyEnds     DateTime?                @map("repair_warranty_ends")
  // 재수리 — 보증 내 같은 증상으로 다시 입고
  parentRepairTicketId   String?                  @map("parent_repair_ticket_id")
  parentRepairTicket     RepairTicket?            @relation("RepairRevisits", fields: [parentRepairTicketId], references: [id], onDelete: SetNull)
  revisits               RepairTicket[]           @relation("RepairRevisits")
  // 작업자 지정
  assignedToId           String?                  @map("assigned_to_id")
  assignedTo             User?                    @relation("RepairAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  // 취소 정보 (status=CANCELLED 일 때만 의미)
  cancelReason           RepairCancelReason?      @map("cancel_reason")
  cancelMemo             String?                  @map("cancel_memo") // OTHER 사유 또는 추가 설명
  cancelledAt            DateTime?                @map("cancelled_at")
  // 견적 거절 정보 — reject_after_quote 액션으로 진단비만 청구한 케이스. 픽업/결제 흐름은 그대로 탐.
  quoteRejectReason      QuoteRejectReason?       @map("quote_reject_reason")
  quoteRejectMemo        String?                  @map("quote_reject_memo")
  quoteRejectedAt        DateTime?                @map("quote_rejected_at")
  // 미등록 손님 추적 — POS 의 어떤 카트 세션에서 만들어졌는지 (등록 손님이면 customerId 로 충분)
  // 클라이언트 sessions.repairTicketIds 추적이 끊겨도 DB 에서 복원 가능. 세션 자체가 사라지면 NULL.
  posSessionId           String?                  @map("pos_session_id")
  posSession             PosSession?              @relation(fields: [posSessionId], references: [id], onDelete: SetNull)
  // 새 수리 접수 시 선택한 상품 카테고리 — 수리 진행 페이지의 "카테고리" 검색 모드에서 사용.
  // null = "기타" (카테고리 미지정 또는 없는 항목)
  repairCategoryId       String?                  @map("repair_category_id")
  repairCategory         ProductCategory?         @relation("RepairCategory", fields: [repairCategoryId], references: [id], onDelete: SetNull)
  memo                   String?
  createdById            String                   @map("created_by_id")
  createdBy              User                     @relation(fields: [createdById], references: [id])
  createdAt              DateTime                 @default(now()) @map("created_at")
  updatedAt              DateTime                 @updatedAt @map("updated_at")

  parts   RepairPart[]
  labors  RepairLabor[]
  // 결제 Order — N:1. 한 Order 에 수리 여러 건 link 가능. 결제 전엔 null.
  orderId String?       @map("order_id")
  order   Order?        @relation(fields: [orderId], references: [id])

  @@index([customerId])
  @@index([status])
  @@index([receivedAt])
  @@index([assignedToId])
  @@index([parentRepairTicketId])
  @@index([serialItemId])
  @@index([posSessionId])
  @@index([repairCategoryId])
  @@index([symptomTemplateId])
  @@index([diagnosisTemplateId])
  @@index([orderId])
  @@map("repair_tickets")
}

/**
 * 증상 템플릿 — 자유 입력으로 들어온 증상 텍스트를 정규화·재사용 가능한 마스터로 관리.
 * 카테고리별로 unique (분무기·세탁기 등 컨텍스트마다 같은 표현이 다른 의미 가능).
 * usageCount = 같은 template 이 RepairTicket 에 연결된 누적 횟수 — 콤보박스 정렬용.
 */
model RepairSymptomTemplate {
  id          String           @id @default(uuid())
  text        String // 예: "압력이 안 생겨요"
  categoryId  String?          @map("category_id")
  category    ProductCategory? @relation("SymptomCategory", fields: [categoryId], references: [id], onDelete: SetNull)
  usageCount  Int              @default(0) @map("usage_count")
  createdById String?          @map("created_by_id")
  createdBy   User?            @relation("SymptomTemplateCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  tickets        RepairTicket[]
  diagnosisLinks SymptomDiagnosisLink[]

  @@unique([categoryId, text])
  @@index([categoryId, usageCount(sort: Desc)])
  @@map("repair_symptom_templates")
}

/**
 * 진단 템플릿 — 증상에 대응되는 진단(원인). 부속/공임과 별개의 자유 텍스트 차원.
 * SymptomDiagnosisLink 와 함께 사용 시: 증상 선택 → 자주 매칭된 진단 자동 추천.
 */
model RepairDiagnosisTemplate {
  id          String           @id @default(uuid())
  text        String // 예: "패킹 마모"
  categoryId  String?          @map("category_id")
  category    ProductCategory? @relation("DiagnosisCategory", fields: [categoryId], references: [id], onDelete: SetNull)
  usageCount  Int              @default(0) @map("usage_count")
  createdById String?          @map("created_by_id")
  createdBy   User?            @relation("DiagnosisTemplateCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  tickets      RepairTicket[]
  symptomLinks SymptomDiagnosisLink[]
  partUsages   DiagnosisPartUsage[]
  laborUsages  DiagnosisLaborUsage[]
  partSets     DiagnosisPartSet[]

  @@unique([categoryId, text])
  @@index([categoryId, usageCount(sort: Desc)])
  @@map("repair_diagnosis_templates")
}

/**
 * 진단 ↔ 부속(Product) 자주 매칭 — 진단 선택 시 부속 추천 정렬에 사용.
 * RepairPart 추가/삭제 hook 에서 자동 upsert (RepairTicket.diagnosisTemplateId 있을 때만).
 */
model DiagnosisPartUsage {
  diagnosisId     String   @map("diagnosis_id")
  productId       String   @map("product_id")
  occurrenceCount Int      @default(1) @map("occurrence_count")
  lastOccurredAt  DateTime @default(now()) @map("last_occurred_at")

  diagnosis RepairDiagnosisTemplate @relation(fields: [diagnosisId], references: [id], onDelete: Cascade)
  product   Product                 @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([diagnosisId, productId])
  @@index([diagnosisId, occurrenceCount(sort: Desc)])
  @@map("diagnosis_part_usage")
}

/**
 * 진단 ↔ "부속·공임 묶음(세트)" 빈도 — Phase 4 세트 매칭.
 * RepairTicket 의 PICKED_UP 전이 시점에만 학습 (확정된 케이스만 통계 반영).
 * 작업 중 토글/실수가 통계 오염하지 않게 종결 시점 집계.
 * normalize: productIds 와 laborNames 는 항상 정렬되어 저장.
 * 같은 (정렬된 productIds, 정렬된 laborNames) 조합은 unique row 1개.
 * 평균 수량·단가는 추천 시 prefill 에 사용 (예: "패킹 보통 5개씩 사용").
 * 누적 평균 = (기존 평균 × (count-1) + 새 값) / count
 */
model DiagnosisPartSet {
  id              String   @id @default(uuid())
  diagnosisId     String   @map("diagnosis_id")
  /**
   * 정렬된 productId 배열 — 부속 묶음을 unique 키로 표현
   */
  productIds      String[] @map("product_ids")
  /**
   * 정렬된 공임 이름 배열
   */
  laborNames      String[] @map("labor_names")
  /**
   * 부속별 평균 수량 — productIds 와 같은 인덱스 순서
   */
  avgQuantities   Float[]  @map("avg_quantities")
  /**
   * 공임별 평균 단가 — laborNames 와 같은 인덱스 순서
   */
  avgLaborRates   Float[]  @map("avg_labor_rates")
  occurrenceCount Int      @default(1) @map("occurrence_count")
  lastOccurredAt  DateTime @default(now()) @map("last_occurred_at")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  diagnosis RepairDiagnosisTemplate @relation(fields: [diagnosisId], references: [id], onDelete: Cascade)

  @@unique([diagnosisId, productIds, laborNames])
  @@index([diagnosisId, occurrenceCount(sort: Desc)])
  @@map("diagnosis_part_sets")
}

/**
 * 진단 ↔ 공임 자유텍스트 자주 매칭 — 진단 선택 시 공임 추천.
 * 공임은 자유 입력 + RepairLaborPreset 양쪽 다 있으므로 텍스트 기준으로 집계 (presetId 가 있으면 보너스).
 */
model DiagnosisLaborUsage {
  diagnosisId     String   @map("diagnosis_id")
  laborName       String   @map("labor_name")
  unitRate        Decimal  @default(0) @map("unit_rate") @db.Decimal(15, 2) // 마지막 입력 단가 — 추천 시 기본값
  occurrenceCount Int      @default(1) @map("occurrence_count")
  lastOccurredAt  DateTime @default(now()) @map("last_occurred_at")

  diagnosis RepairDiagnosisTemplate @relation(fields: [diagnosisId], references: [id], onDelete: Cascade)

  @@id([diagnosisId, laborName])
  @@index([diagnosisId, occurrenceCount(sort: Desc)])
  @@map("diagnosis_labor_usage")
}

/**
 * 증상 ↔ 진단 관계. RepairTicket 저장 시 두 template 이 모두 있으면 자동으로 upsert + occurrenceCount++.
 * 콤보박스에서 증상 선택 후 진단 추천 정렬에 사용.
 */
model SymptomDiagnosisLink {
  symptomId       String   @map("symptom_id")
  diagnosisId     String   @map("diagnosis_id")
  occurrenceCount Int      @default(1) @map("occurrence_count")
  lastOccurredAt  DateTime @default(now()) @map("last_occurred_at")

  symptom   RepairSymptomTemplate   @relation(fields: [symptomId], references: [id], onDelete: Cascade)
  diagnosis RepairDiagnosisTemplate @relation(fields: [diagnosisId], references: [id], onDelete: Cascade)

  @@id([symptomId, diagnosisId])
  @@index([symptomId, occurrenceCount(sort: Desc)])
  @@map("symptom_diagnosis_links")
}

model RepairPart {
  id               String           @id @default(uuid())
  repairTicketId   String           @map("repair_ticket_id")
  repairTicket     RepairTicket     @relation(fields: [repairTicketId], references: [id], onDelete: Cascade)
  productId        String           @map("product_id")
  product          Product          @relation(fields: [productId], references: [id])
  quantity         Decimal          @db.Decimal(15, 4)
  unitPrice        Decimal          @map("unit_price") @db.Decimal(15, 2)
  totalPrice       Decimal          @map("total_price") @db.Decimal(15, 2)
  unitCostSnapshot Decimal?         @map("unit_cost_snapshot") @db.Decimal(15, 4)
  consumedAt       DateTime?        @map("consumed_at")
  status           RepairPartStatus @default(USED)
  // LOST 부속 손님 청구 여부 — true 면 합계에 포함되어 청구. false (기본) 면 회사 손실.
  // 케이스: 수리 도중 손님 포기 시 일부 부속비 청구. status=LOST 일 때만 의미.
  billLost         Boolean          @default(false) @map("bill_lost")
  discount         String           @default("0") // 라인 할인 — "1000" or "10%"
  createdAt        DateTime         @default(now()) @map("created_at")

  lotConsumptions LotConsumption[]

  @@index([repairTicketId])
  @@map("repair_parts")
}

model RepairLabor {
  id             String       @id @default(uuid())
  repairTicketId String       @map("repair_ticket_id")
  repairTicket   RepairTicket @relation(fields: [repairTicketId], references: [id], onDelete: Cascade)
  name           String
  hours          Decimal      @default(1) @db.Decimal(10, 2)
  unitRate       Decimal      @map("unit_rate") @db.Decimal(15, 2)
  totalPrice     Decimal      @map("total_price") @db.Decimal(15, 2)
  createdAt      DateTime     @default(now()) @map("created_at")

  @@index([repairTicketId])
  @@map("repair_labors")
}

// 판매 기술료/공임 프리셋 — 상품 판매 시 장착·설치 등 추가 청구하는 기술료.
// POS 카트·ERP 주문 생성에서 빠르게 선택. 수리(RepairLaborPreset) 와 별개 — 판매 라인용.
model ServiceFeePreset {
  id        String   @id @default(uuid())
  name      String // 예: "장착비", "출장 설치비"
  unitPrice Decimal  @map("unit_price") @db.Decimal(15, 2) // 세전 공급가액 (항상 과세)
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")
  memo      String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("service_fee_presets")
}

// ============================================================
// 수리 서비스 카탈로그 (공임 프리셋 / 수리 패키지)
// ============================================================

model RepairLaborPreset {
  id          String   @id @default(uuid())
  name        String
  description String?
  unitRate    Decimal  @map("unit_rate") @db.Decimal(15, 2)
  isActive    Boolean  @default(true) @map("is_active")
  memo        String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  packageLabors RepairPackageLabor[]

  @@map("repair_labor_presets")
}

model RepairPackage {
  id          String   @id @default(uuid())
  name        String
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  memo        String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  labors RepairPackageLabor[]
  parts  RepairPackagePart[]

  @@map("repair_packages")
}

model RepairPackageLabor {
  id            String             @id @default(uuid())
  packageId     String             @map("package_id")
  package       RepairPackage      @relation(fields: [packageId], references: [id], onDelete: Cascade)
  laborPresetId String?            @map("labor_preset_id")
  laborPreset   RepairLaborPreset? @relation(fields: [laborPresetId], references: [id])
  name          String
  unitRate      Decimal            @map("unit_rate") @db.Decimal(15, 2)
  quantity      Int                @default(1)
  sortOrder     Int                @default(0) @map("sort_order")

  @@index([packageId])
  @@map("repair_package_labors")
}

model RepairPackagePart {
  id        String        @id @default(uuid())
  packageId String        @map("package_id")
  package   RepairPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  productId String        @map("product_id")
  product   Product       @relation(fields: [productId], references: [id])
  quantity  Decimal       @db.Decimal(15, 4)
  unitPrice Decimal       @map("unit_price") @db.Decimal(15, 2)

  @@index([packageId])
  @@map("repair_package_parts")
}

// ============================================================
// 임대 (RentalAsset / Rental) — 판매 재고와 완전 분리
// ============================================================

enum RentalAssetStatus {
  AVAILABLE
  RENTED
  MAINTENANCE
  RETIRED
}

enum RentalRateType {
  DAILY
  MONTHLY
}

enum RentalStatus {
  RESERVED
  ACTIVE
  RETURNED
  OVERDUE
  CANCELLED
}

model RentalAsset {
  id                   String            @id @default(uuid())
  assetNo              String            @unique @map("asset_no")
  name                 String
  brand                String?
  modelNo              String?           @map("model_no")
  /// 자산 자체 이미지 URL — Product 와 분리. POS 그리드/라벨에서 우선 사용.
  imageUrl             String?           @map("image_url")
  productId            String?           @map("product_id")
  product              Product?          @relation(fields: [productId], references: [id])
  dailyRate            Decimal           @default(0) @map("daily_rate") @db.Decimal(15, 2)
  monthlyRate          Decimal           @default(0) @map("monthly_rate") @db.Decimal(15, 2)
  depositAmount        Decimal           @default(0) @map("deposit_amount") @db.Decimal(15, 2)
  status               RentalAssetStatus @default(AVAILABLE)
  acquiredAt           DateTime?         @map("acquired_at")
  memo                 String?
  isActive             Boolean           @default(true) @map("is_active")
  // 임대 QR — 자산번호 기반 영구 출입증. 손님이 QR 찍으면 /r/[token] 사용법 페이지.
  // 분실 시에만 매장이 재발급. manualBlocks 는 이 자산 전용 사용법(ManualBlock[]).
  accessToken          String?           @unique @map("access_token")
  accessTokenRevokedAt DateTime?         @map("access_token_revoked_at")
  manualBlocks         Json?             @map("manual_blocks")
  hasManual            Boolean           @default(false) @map("has_manual")
  createdAt            DateTime          @default(now()) @map("created_at")
  updatedAt            DateTime          @updatedAt @map("updated_at")

  rentals           Rental[]
  // 임대 lifecycle 종료 후 중고로 전환된 경우 양방향 link
  convertedUsedItem UsedItem?

  @@map("rental_assets")
}

model Rental {
  id               String              @id @default(uuid())
  rentalNo         String              @unique @map("rental_no")
  assetId          String              @map("asset_id")
  asset            RentalAsset         @relation(fields: [assetId], references: [id])
  customerId       String              @map("customer_id")
  customer         Customer            @relation(fields: [customerId], references: [id])
  status           RentalStatus        @default(RESERVED)
  startDate        DateTime            @map("start_date")
  endDate          DateTime            @map("end_date")
  actualReturnedAt DateTime?           @map("actual_returned_at")
  rateType         RentalRateType      @map("rate_type")
  unitRate         Decimal             @map("unit_rate") @db.Decimal(15, 2)
  totalUnits       Int                 @map("total_units")
  rentalAmount     Decimal             @map("rental_amount") @db.Decimal(15, 2)
  depositAmount    Decimal             @default(0) @map("deposit_amount") @db.Decimal(15, 2)
  depositReturned  Boolean             @default(false) @map("deposit_returned")
  overdueAmount    Decimal             @default(0) @map("overdue_amount") @db.Decimal(15, 2)
  finalAmount      Decimal             @default(0) @map("final_amount") @db.Decimal(15, 2)
  paymentMethod    OrderPaymentMethod? @map("payment_method")
  /**
   * 픽업/접수 시각 — 카트에서 임대 라인을 추가한 순간 캡처. 시간대별 임대 트래픽 분석용.
   */
  checkoutAt       DateTime?           @map("checkout_at")
  memo             String?
  createdById      String              @map("created_by_id")
  createdBy        User                @relation(fields: [createdById], references: [id])
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")

  // Order.rentalId 가 @unique 이므로 1:1 — 결제 Order 0~1건
  order Order?

  @@index([customerId])
  @@index([assetId])
  @@index([status])
  @@index([startDate, endDate])
  @@index([checkoutAt])
  @@map("rentals")
}

model Expense {
  id             String              @id @default(uuid())
  date           DateTime
  amount         Decimal             @db.Decimal(12, 2)
  category       ExpenseCategory
  description    String
  isTaxable      Boolean             @default(true) @map("is_taxable")
  recoverable    Boolean             @default(false) @map("recoverable")
  paymentMethod  OrderPaymentMethod? @map("payment_method")
  supplierId     String?             @map("supplier_id")
  supplier       Supplier?           @relation(fields: [supplierId], references: [id])
  customerId     String?             @map("customer_id")
  customer       Customer?           @relation(fields: [customerId], references: [id])
  createdById    String?             @map("created_by_id")
  createdBy      User?               @relation(fields: [createdById], references: [id])
  referenceId    String?             @map("reference_id")
  referenceType  String?             @map("reference_type")
  memo           String?
  attachmentUrl  String?             @map("attachment_url")
  attachmentPath String?             @map("attachment_path")
  attachmentName String?             @map("attachment_name")
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")

  @@index([date])
  @@index([category])
  @@index([supplierId])
  @@index([customerId])
  @@index([createdById])
  @@map("expenses")
}

enum ExpenseCategory {
  SHIPPING
  RENT
  UTILITIES
  SALARY
  PACKAGING
  OFFICE_SUPPLIES
  MARKETING
  MAINTENANCE
  INVENTORY_USAGE
  OTHER
}

/**
 * 재무상태표 수기 항목 분류 — 시스템이 자동 산출 못 하는 회계 모듈 영역.
 * 자산: CASH(현금·예금), EQUIPMENT(비품·설비 장부가), OTHER_ASSET
 * 부채: LOAN(차입금), OTHER_LIABILITY
 * 자본: CAPITAL(자본금), RETAINED_EARNINGS(이익잉여금 — 전기 누적)
 */
enum ManualBalanceCategory {
  CASH
  EQUIPMENT
  OTHER_ASSET
  LOAN
  OTHER_LIABILITY
  CAPITAL
  RETAINED_EARNINGS
}

/**
 * 재무상태표 수기 입력 항목 — 운영자가 직접 등록·갱신하는 현재 시점 잔량.
 * 매출채권/재고/매입채무처럼 시스템이 자동 산출하는 항목 외의 보강용.
 */
model ManualBalanceEntry {
  id        String                @id @default(uuid())
  category  ManualBalanceCategory
  label     String
  amount    Decimal               @db.Decimal(15, 2)
  memo      String?
  createdAt DateTime              @default(now()) @map("created_at")
  updatedAt DateTime              @updatedAt @map("updated_at")

  @@index([category])
  @@map("manual_balance_entries")
}

// ============================================================
// 조립상품 템플릿 · 프리셋
// ============================================================

model AssemblyTemplate {
  id               String   @id @default(uuid())
  name             String
  description      String?
  defaultLaborCost Decimal? @map("default_labor_cost") @db.Decimal(15, 2)
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  slots              AssemblyTemplateSlot[]
  presets            AssemblyPreset[]
  defaultForProducts Product[]              @relation("ProductDefaultTemplate")
  usedItemBuilds     UsedItemBuild[]

  @@map("assembly_templates")
}

model AssemblyTemplateSlot {
  id               String             @id @default(uuid())
  templateId       String             @map("template_id")
  template         AssemblyTemplate   @relation(fields: [templateId], references: [id], onDelete: Cascade)
  label            String
  slotLabelId      String?            @map("slot_label_id")
  slotLabel        AssemblySlotLabel? @relation(fields: [slotLabelId], references: [id], onDelete: Restrict)
  order            Int
  defaultProductId String?            @map("default_product_id")
  defaultProduct   Product?           @relation(fields: [defaultProductId], references: [id], onDelete: SetNull)
  defaultQuantity  Decimal            @default(1) @map("default_quantity") @db.Decimal(10, 4)
  isVariable       Boolean            @default(false) @map("is_variable")

  presetItems   AssemblyPresetItem[]
  setComponents SetComponent[]

  @@index([templateId, order])
  @@index([slotLabelId])
  @@map("assembly_template_slots")
}

model AssemblySlotLabel {
  id         String           @id @default(uuid())
  name       String           @unique
  isActive   Boolean          @default(true) @map("is_active")
  // 이 라벨이 지정될 슬롯의 후보 상품을 좁히는 카테고리. 설정 시 상품등록·조립등록의
  // 구성품 콤보박스가 해당 카테고리 상품만 노출. 미설정 시 전체 노출 (기존 동작).
  categoryId String?          @map("category_id")
  category   ProductCategory? @relation("SlotLabelCategory", fields: [categoryId], references: [id], onDelete: SetNull)
  createdAt  DateTime         @default(now()) @map("created_at")
  updatedAt  DateTime         @updatedAt @map("updated_at")

  slots         AssemblyTemplateSlot[]
  setComponents SetComponent[]

  @@map("assembly_slot_labels")
}

model AssemblyPreset {
  id          String           @id @default(uuid())
  templateId  String           @map("template_id")
  template    AssemblyTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  name        String
  description String?
  isActive    Boolean          @default(true) @map("is_active")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  items AssemblyPresetItem[]

  @@unique([templateId, name])
  @@map("assembly_presets")
}

model AssemblyPresetItem {
  id        String               @id @default(uuid())
  presetId  String               @map("preset_id")
  preset    AssemblyPreset       @relation(fields: [presetId], references: [id], onDelete: Cascade)
  slotId    String               @map("slot_id")
  slot      AssemblyTemplateSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
  productId String               @map("product_id")
  product   Product              @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity  Decimal              @db.Decimal(10, 4)

  @@unique([presetId, slotId])
  @@map("assembly_preset_items")
}

// ============================================================
// 조립 실적 (Assembly / Disassembly)
// ============================================================

enum AssemblyType {
  PRODUCE
  DISASSEMBLE
}

model Assembly {
  id            String       @id @default(uuid())
  assemblyNo    String       @unique @map("assembly_no")
  productId     String       @map("product_id")
  product       Product      @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity      Decimal      @db.Decimal(10, 4)
  type          AssemblyType @default(PRODUCE)
  laborCost     Decimal?     @map("labor_cost") @db.Decimal(15, 2)
  assembledAt   DateTime     @map("assembled_at")
  memo          String?
  producedLotId String?      @map("produced_lot_id")
  reverseOfId   String?      @unique @map("reverse_of_id")
  reverseOf     Assembly?    @relation("AssemblyReverse", fields: [reverseOfId], references: [id])
  reversedBy    Assembly?    @relation("AssemblyReverse")
  createdBy     String?      @map("created_by")
  createdAt     DateTime     @default(now()) @map("created_at")

  consumptions         AssemblyComponentConsumption[]
  // 이 조립 인스턴스에 끼운 UsedItem 들 (자유 라인, BOM 정의 외)
  usedItemConsumptions AssemblyUsedItemConsumption[]

  @@index([productId, assembledAt])
  @@map("assemblies")
}

model AssemblyComponentConsumption {
  id          String   @id @default(uuid())
  assemblyId  String   @map("assembly_id")
  assembly    Assembly @relation(fields: [assemblyId], references: [id], onDelete: Cascade)
  componentId String   @map("component_id")
  component   Product  @relation(fields: [componentId], references: [id], onDelete: Restrict)
  lotId       String   @map("lot_id")
  quantity    Decimal  @db.Decimal(10, 4)
  unitCost    Decimal  @map("unit_cost") @db.Decimal(15, 4)

  @@index([assemblyId])
  @@index([lotId])
  @@map("assembly_component_consumptions")
}

// ============================================================
// SerialItem — 개별 시리얼 라벨 (큰 상품 추적용)
// 자세한 기획은 docs/serial-item-plan.md 참조
// ============================================================

enum SerialItemStatus {
  ACTIVE
  RETURNED
  SCRAPPED
}

// 시리얼 라벨 발번 출처. SALE=일반 판매, REPAIR=수리 받으러 온 기기에 부여(시스템 도입 전 판매분 등).
// USED_INTAKE=중고 매입 시점 발번 (UsedItem 단품 판매 가능 케이스).
// 임대 자산은 SerialItem 이 아니라 RentalAsset 자체의 QR(accessToken)로 별도 운영.
enum SerialItemSource {
  SALE
  REPAIR
  USED_INTAKE
}

// 손님 공개 페이지(/s/[token]) 접근 단계 — SerialAccessLog.stage
enum SerialAccessStage {
  PAGE_VIEW // QR 진입 (1단계, 마스킹된 공개 정보)
  AUTH_SUCCESS // 본인확인 통과 (2단계, 풀공개)
  AUTH_FAIL // 본인확인 실패
}

// 본인확인 실패 사유 — SerialAccessLog.failReason (stage=AUTH_FAIL 일 때만)
enum SerialAccessFailReason {
  WRONG_NAME
  WRONG_PHONE
  RATE_LIMITED
}

model SerialItem {
  id                   String           @id @default(uuid())
  code                 String           @unique // "YYMMDD-NNNN" — 일별 4자리 시퀀스
  // 손님 공개 페이지(/s/[token]) 출입증. 시리얼 코드와 분리된 추측 불가능한 랜덤 토큰.
  // 라벨 QR 에만 인쇄됨. 분실·재발급 시 새 토큰 발급 + 이전 토큰 revoke.
  accessToken          String?          @unique @map("access_token")
  accessTokenRevokedAt DateTime?        @map("access_token_revoked_at")
  // 보증만료+N년 경과 후 cron 이 손님 개인정보(이름/전화 등 연결)를 끊고 익명화한 시각.
  anonymizedAt         DateTime?        @map("anonymized_at")
  // productId 는 nullable — 외부에서 가져온 기기(카탈로그에 없음) 의 수리 라벨은 productId 없이
  // displayName 만으로 식별. 일반 판매 라벨은 productId 가 있고 displayName 은 null.
  productId            String?          @map("product_id")
  product              Product?         @relation(fields: [productId], references: [id], onDelete: SetNull)
  displayName          String?          @map("display_name") // 카탈로그 없는 기기명 (예: "Sony A7M4 Black")
  source               SerialItemSource @default(SALE)
  orderItemId          String?          @map("order_item_id")
  orderItem            OrderItem?       @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  customerId           String?          @map("customer_id")
  customer             Customer?        @relation(fields: [customerId], references: [id], onDelete: SetNull)
  // USED_INTAKE 발번 시점엔 판매 전이라 nullable. 단품 판매 시 자동 채움.
  soldAt               DateTime?        @map("sold_at")
  warrantyEnds         DateTime?        @map("warranty_ends")
  status               SerialItemStatus @default(ACTIVE)
  memo                 String?
  createdAt            DateTime         @default(now()) @map("created_at")
  updatedAt            DateTime         @updatedAt @map("updated_at")

  repairTickets RepairTicket[]
  accessLogs    SerialAccessLog[]
  usedItem      UsedItem?

  @@index([code])
  @@index([productId])
  @@index([customerId])
  @@index([orderItemId])
  @@index([source])
  @@map("serial_items")
}

// 손님 공개 페이지 접근 기록 — PIPA 접근기록 보관 의무(1년+) 충족 + 분쟁 대비.
model SerialAccessLog {
  id           String                  @id @default(uuid())
  serialItemId String                  @map("serial_item_id")
  serialItem   SerialItem              @relation(fields: [serialItemId], references: [id], onDelete: Cascade)
  accessToken  String                  @map("access_token") // 사용된 토큰 (revoke 된 토큰 추적용)
  stage        SerialAccessStage
  failReason   SerialAccessFailReason? @map("fail_reason")
  ipHash       String?                 @map("ip_hash") // IP 원본 저장 금지 — SHA-256 해시
  userAgent    String?                 @map("user_agent")
  accessedAt   DateTime                @default(now()) @map("accessed_at")

  @@index([serialItemId])
  @@index([accessedAt])
  @@map("serial_access_logs")
}

// ============================================================
// UsedItem — 중고 도메인 (전체 설계: docs/USED_ITEMS_DESIGN.md)
// ============================================================
//
// 카탈로그 신품 (Product) 과 별개로 중고 단품을 추적.
// - 카탈로그 매칭되면 productId link (같은 모델 신품과 비교 가능)
// - 비카탈로그 (매장이 평소 안 다루는 모델) 도 자유 입력으로 수용
// - status lifecycle: IN_STOCK → ASSEMBLED_INTO / SOLD / SCRAPPED
// - 폐기 시 자동으로 Expense row 생성 (acquiredCost + addedCosts 합)
// - 시리얼 발번 가능 (USED_INTAKE source) — 단품 판매 시 손님 정보 덮어쓰기
// - 임대 자산 (RentalAsset) 에서 lifecycle 종료 후 전환 가능
// - Assembly 자유 라인으로 끼움 가능 (UI 변경 없이 구성품 검색에 통합)

model UsedItem {
  id           String @id @default(uuid())
  // UU{YYMMDD}-NNNN — internalCode (라벨/검색 식별자)
  internalCode String @unique @map("internal_code")
  // 자유 입력 (비카탈로그도 OK). 카탈로그 매칭이면 보통 product.name 과 같지만 매장이 별도 표기 가능.
  displayName  String @map("display_name")

  // 카탈로그 매칭 — 있으면 같은 모델의 신품과 묶임. null 이면 순수 비카탈로그 단품.
  productId String?  @map("product_id")
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  // 매입 정보
  acquiredFrom      UsedItemSource @map("acquired_from")
  acquiredCost      Decimal        @default(0) @map("acquired_cost") @db.Decimal(15, 2)
  // VAT 처리 — 95% 개인 매입이라 기본 false (받은 금액 = 공급가액).
  // 사업자 매입으로 세금계산서 받은 드문 케이스만 true (받은 금액 ÷ 1.1 = 공급가액).
  isAcquiredTaxable Boolean        @default(false) @map("is_acquired_taxable")
  acquiredAt        DateTime       @map("acquired_at")

  // 매입처 — 등록 고객은 sourceCustomer, 비등록은 sourceMemo 자유 텍스트
  sourceCustomerId String?   @map("source_customer_id")
  sourceCustomer   Customer? @relation("UsedItemSourceCustomer", fields: [sourceCustomerId], references: [id], onDelete: SetNull)
  sourceMemo       String?   @map("source_memo")

  // lifecycle
  status UsedItemStatus @default(IN_STOCK)

  // 상세
  spec      String?
  imageUrls Json?   @map("image_urls") // ["https://..." , ...]
  memo      String?

  // 사후 비용 가산 (수리·부품·공임 등) — 합계는 OrderItem.unitCostSnapshot 에 흡수
  addedCosts UsedItemCost[]

  // 결과 lineage — 셋 중 하나 (배타적)
  // ASSEMBLED_INTO 시 — 어느 Assembly 인스턴스에 흡수됐는지 (AssemblyUsedItemConsumption 으로 더 풍부하게 추적)
  // SOLD 시         — 어느 OrderItem 으로 판매됐는지
  // (SCRAPPED 시는 lineage 없음, 자동 Expense 만)
  orderItemId String?    @unique @map("order_item_id")
  orderItem   OrderItem? @relation(fields: [orderItemId], references: [id], onDelete: SetNull)

  // 임대 자산에서 전환된 출처 (역방향) — 1:1
  rentalAssetId String?      @unique @map("rental_asset_id")
  rentalAsset   RentalAsset? @relation(fields: [rentalAssetId], references: [id], onDelete: SetNull)

  // 시리얼 발번 — 단품 판매 가능 케이스만 (매입 등록 시 토글). 1:1
  serialItemId String?     @unique @map("serial_item_id")
  serialItem   SerialItem? @relation(fields: [serialItemId], references: [id], onDelete: SetNull)

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  createdById String?  @map("created_by_id")

  // Assembly 흡수 detail (status=ASSEMBLED_INTO 일 때 1건)
  assemblyConsumption AssemblyUsedItemConsumption?

  // 중고 조립 (케이스 B) — 이 단품이 "조립 결과물" 이면 1건 (source=BUILT)
  buildAsResult UsedItemBuild?       @relation("UsedItemBuildResult")
  // 이 단품이 다른 조립의 "재료" 로 소진됐으면 1건 (status=ASSEMBLED_INTO)
  buildAsSource UsedItemBuildSource?

  @@index([productId])
  @@index([status])
  @@index([acquiredFrom])
  @@index([sourceCustomerId])
  @@index([createdAt])
  @@map("used_items")
}

// 사후 비용 가산 (SSD 교체 6만, 공임 2만 등)
model UsedItemCost {
  id            String           @id @default(uuid())
  usedItemId    String           @map("used_item_id")
  usedItem      UsedItem         @relation(fields: [usedItemId], references: [id], onDelete: Cascade)
  costType      UsedItemCostType @map("cost_type")
  amount        Decimal          @db.Decimal(15, 2)
  description   String
  referenceType String?          @map("reference_type") // REPAIR_TICKET | MANUAL ...
  referenceId   String?          @map("reference_id")
  createdAt     DateTime         @default(now()) @map("created_at")
  createdById   String?          @map("created_by_id")

  @@index([usedItemId])
  @@map("used_item_costs")
}

// Assembly 인스턴스가 흡수한 UsedItem — 자유 라인 (BOM 정의에 없는 ad-hoc).
// 결과 lot.unitCost 합산에 costSnapshot 사용. UsedItem 1개 = 1 record.
model AssemblyUsedItemConsumption {
  id           String   @id @default(uuid())
  assemblyId   String   @map("assembly_id")
  assembly     Assembly @relation(fields: [assemblyId], references: [id], onDelete: Cascade)
  usedItemId   String   @unique @map("used_item_id")
  usedItem     UsedItem @relation(fields: [usedItemId], references: [id], onDelete: Restrict)
  // 흡수 시점의 (acquiredCost + Σ addedCosts) 스냅샷. 이후 addedCosts 변경되어도 결과 lot.unitCost 불변.
  costSnapshot Decimal  @map("cost_snapshot") @db.Decimal(15, 2)
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([assemblyId])
  @@map("assembly_used_item_consumptions")
}

// 중고 조립 (케이스 B) — 여러 중고 + (선택) 신품 부품을 합쳐 새 단품(BUILT)을 만듦.
// 카탈로그 Product 를 만들지 않아 더미 SKU 가 안 생김. 결과물도 일회성 단품.
model UsedItemBuild {
  id                 String            @id @default(uuid())
  // 결과물 — source=BUILT 인 UsedItem (1:1)
  resultUsedItemId   String            @unique @map("result_used_item_id")
  resultUsedItem     UsedItem          @relation("UsedItemBuildResult", fields: [resultUsedItemId], references: [id], onDelete: Cascade)
  // 사용한 조립 템플릿 (선택) — 슬롯 구조를 빌려옴. null 이면 자유 모드 빌드.
  assemblyTemplateId String?           @map("assembly_template_id")
  assemblyTemplate   AssemblyTemplate? @relation(fields: [assemblyTemplateId], references: [id], onDelete: SetNull)
  laborCost          Decimal           @default(0) @map("labor_cost") @db.Decimal(15, 2)
  builtAt            DateTime          @map("built_at")
  memo               String?
  createdById        String?           @map("created_by_id")
  createdAt          DateTime          @default(now()) @map("created_at")

  usedItemSources  UsedItemBuildSource[]
  partConsumptions UsedItemBuildPart[]

  @@index([resultUsedItemId])
  @@index([assemblyTemplateId])
  @@map("used_item_builds")
}

// 조립 재료 ① — 소진된 중고 단품 (status=ASSEMBLED_INTO). UsedItem 1개 = 1 record.
model UsedItemBuildSource {
  id           String        @id @default(uuid())
  buildId      String        @map("build_id")
  build        UsedItemBuild @relation(fields: [buildId], references: [id], onDelete: Cascade)
  usedItemId   String        @unique @map("used_item_id")
  usedItem     UsedItem      @relation(fields: [usedItemId], references: [id], onDelete: Restrict)
  // 소진 시점 (acquiredCost + Σ addedCosts) 스냅샷 — 결과물 누적원가 합산에 사용
  costSnapshot Decimal       @map("cost_snapshot") @db.Decimal(15, 2)
  // 어느 슬롯에 들어갔는지 (템플릿 모드). 자유 모드면 null.
  slotLabel    String?       @map("slot_label")

  @@index([buildId])
  @@map("used_item_build_sources")
}

// 조립 재료 ② — 소진된 신품 부품 lot (FIFO 차감). 한 Product 가 여러 lot 으로 나뉘면 여러 record.
model UsedItemBuildPart {
  id          String        @id @default(uuid())
  buildId     String        @map("build_id")
  build       UsedItemBuild @relation(fields: [buildId], references: [id], onDelete: Cascade)
  componentId String        @map("component_id")
  component   Product       @relation("ProductUsedItemBuildPart", fields: [componentId], references: [id], onDelete: Restrict)
  lotId       String        @map("lot_id")
  quantity    Decimal       @db.Decimal(10, 4)
  unitCost    Decimal       @map("unit_cost") @db.Decimal(15, 4)
  // 어느 슬롯에 들어갔는지 (템플릿 모드). 자유 모드면 null.
  slotLabel   String?       @map("slot_label")

  @@index([buildId])
  @@index([lotId])
  @@map("used_item_build_parts")
}

enum UsedItemSource {
  PURCHASED // 손님에게서 매입 (또는 외부 일반 매입)
  SCAVENGED // 손님이 버리고 간 기기에서 탈거 (원가 0)
  RENTAL_RETIREMENT // 임대 자산 lifecycle 종료 후 중고로 전환
  EMERGENCY_USE // 시스템 등록 전 급매 → 사후 reconcile 로 정리
  BUILT // 여러 중고 + (선택) 신품 부품을 조립해 만든 단품 (케이스 B)
}

enum UsedItemStatus {
  IN_STOCK // 보관 중 — 매대 노출 대상
  ASSEMBLED_INTO // 조립에 흡수됨
  SOLD // 단품 판매 완료
  SCRAPPED // 폐기 — 자동 Expense 생성
}

enum UsedItemCostType {
  PART
  LABOR
  OTHER
}

// 개인정보처리방침 버전 — 손님 동의 버전 관리. 정책 갱신 시 새 row + isCurrent 이전.
model PrivacyPolicyVersion {
  id          String   @id // "v1.0", "v1.1" ...
  content     String // 약관 본문
  publishedAt DateTime @default(now()) @map("published_at")
  isCurrent   Boolean  @default(false) @map("is_current")

  @@map("privacy_policy_versions")
}

// ============================================================
// POS 카트 세션 — 디바이스간 공유용 서버 저장소
// ============================================================

// 한 user 의 카트 세션을 여러 기기에서 공유. id 는 클라이언트 sessionId 그대로
// 사용(genClientId). items / labelCodes / repairTicketIds 는 JSON 으로 저장 —
// 정규화는 매 push 마다 부담 크고, 카트는 결제 시까지 임시 데이터라 큰 의미 없음.
model PosSession {
  id                   String    @id // 클라이언트 sessionId 와 동일
  userId               String    @map("user_id")
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // 고객 — 등록 고객은 customerId, 미등록은 null + customerName 도 null
  customerId           String?   @map("customer_id")
  customer             Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerName         String?   @map("customer_name")
  customerPhone        String?   @map("customer_phone")
  // 카트 메타
  label                String    @default("고객")
  totalDiscount        String    @default("0") @map("total_discount")
  shippingCost         String    @default("0") @map("shipping_cost")
  items                Json      @default("[]") // CartItem[] — JSON 직렬화
  // 견적/라벨/수리 추적 (모두 옵셔널)
  quotationId          String?   @map("quotation_id")
  quotationFingerprint String?   @map("quotation_fingerprint")
  labelCodes           Json?     @map("label_codes")
  labelFingerprint     String?   @map("label_fingerprint")
  repairTicketIds      Json?     @map("repair_ticket_ids") // string[] — deprecated, RepairTicket.posSessionId 로 대체. 호환성 유지를 위해 잠시 보존
  openRepairCount      Int?      @map("open_repair_count")
  // 동기화 메타
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")
  // soft delete — 다른 기기가 옛 sessionStorage 데이터로 sync 해서 부활하는 것을 막기 위함.
  // null = active. 값 있으면 GET 응답에서 제외 + POST 시 그 id 로 들어온 upsert 거부.
  deletedAt            DateTime? @map("deleted_at")
  // 장바구니 저장 — null = 그리드 활성, 값 있으면 그리드에서 숨기되 "저장된 상담" 페이지에서 부활 가능.
  // 라인의 productId 만 의미있고 가격은 부활 시점에 현재 sellingPrice 로 다시 계산.
  parkedAt             DateTime? @map("parked_at")

  // 역참조 — 이 세션에서 만든 미등록 손님의 수리 티켓들 (등록 손님은 customer.repairs 로)
  repairTickets RepairTicket[]

  @@index([userId])
  @@index([userId, updatedAt])
  @@index([customerId])
  @@index([deletedAt])
  @@index([userId, parkedAt])
  @@map("pos_sessions")
}
