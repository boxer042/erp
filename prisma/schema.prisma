// ============================================================
// 입고 관리
// ============================================================

enum IncomingStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

model Incoming {
  id                String         @id @default(uuid())
  incomingNo        String         @unique @map("incoming_no")
  supplierId        String         @map("supplier_id")
  supplier          Supplier       @relation(fields: [supplierId], references: [id])
  status            IncomingStatus @default(PENDING)
  incomingDate      DateTime       @map("incoming_date")
  totalAmount       Decimal        @default(0) @map("total_amount") @db.Decimal(15, 2)
  taxAmount         Decimal        @default(0) @map("tax_amount") @db.Decimal(15, 2)
  shippingCost      Decimal        @default(0) @map("shipping_cost") @db.Decimal(12, 2)
  shippingIsTaxable Boolean        @default(true) @map("shipping_is_taxable")
  shippingDeducted  Boolean        @default(false) @map("shipping_deducted")
  memo              String?
  quotationId       String?        @map("quotation_id")
  quotation         Quotation?     @relation(fields: [quotationId], references: [id])
  purchaseOrderId   String?        @map("purchase_order_id")
  purchaseOrder     PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  createdById       String         @map("created_by_id")
  createdBy         User           @relation(fields: [createdById], references: [id])
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")

  items          IncomingItem[]
  supplierReturn SupplierReturn?

  @@index([supplierId, incomingDate])
  @@index([purchaseOrderId])
  @@map("incomings")
}

model IncomingItem {
  id                    String             @id @default(uuid())
  incomingId            String             @map("incoming_id")
  incoming              Incoming           @relation(fields: [incomingId], references: [id], onDelete: Cascade)
  supplierProductId     String             @map("supplier_product_id")
  supplierProduct       SupplierProduct    @relation(fields: [supplierProductId], references: [id])
  inventoryLots         InventoryLot[]
  quantity              Decimal            @db.Decimal(15, 4)
  originalPrice         Decimal?           @map("original_price") @db.Decimal(15, 2)
  discountAmount        Decimal?           @map("discount_amount") @db.Decimal(15, 2)
  unitPrice             Decimal            @map("unit_price") @db.Decimal(15, 2)
  totalPrice            Decimal            @map("total_price") @db.Decimal(15, 2)
  unitCostSnapshot      Decimal?           @map("unit_cost_snapshot") @db.Decimal(15, 4)
  itemShippingCost      Decimal?           @map("item_shipping_cost") @db.Decimal(12, 2)
  itemShippingIsTaxable Boolean            @default(true) @map("item_shipping_is_taxable")
  memo                  String?
  purchaseOrderItemId   String?            @map("purchase_order_item_id")
  purchaseOrderItem     PurchaseOrderItem? @relation(fields: [purchaseOrderItemId], references: [id])

  @@index([purchaseOrderItemId])
  @@map("incoming_items")
}

// ============================================================
// 발주 (PurchaseOrder)
// ============================================================
//
// 거래처에게 실제 주문을 넣는 단계. 매입견적서(RFQ)와는 다름.
// 발주 → 입고 흐름:
//   DRAFT(작성중) → SENT(발송) → CONFIRMED(거래처 수락) → PARTIAL(분할 입고 진행) →
//     RECEIVED(전량 입고) | CLOSED(부분만 받고 조기 종료) | CANCELLED(취소)
// 한 발주에서 여러 입고로 분할 가능 (PurchaseOrderItem.receivedQty 누적).

enum PurchaseOrderStatus {
  DRAFT
  SENT
  CONFIRMED
  COUNTER_OFFER        // 거래처가 단가 변경 요청 — 우리(발주자)가 수락/거절 결정
  PARTIAL              // 부분입고 발생 (일부 받음, 결정 대기)
  PARTIAL_RESENT       // 부분입고 재발송 (거래처에 잔량 재요청)
  PARTIAL_REACCEPTED   // 부분입고 수락 (거래처가 재요청 수락)
  PARTIAL_COMPLETED    // 부분입고 완료 (부분입고 후 모두 받음, 이력 보존)
  RECEIVED             // 정상 입고완료 (한 번에 모두 받음)
  CLOSED               // 부분입고 종결 (잔량 포기)
  CANCELLED
}

model PurchaseOrder {
  id           String              @id @default(uuid())
  poNo         String              @unique @map("po_no")
  supplierId   String              @map("supplier_id")
  supplier     Supplier            @relation(fields: [supplierId], references: [id])
  status       PurchaseOrderStatus @default(DRAFT)
  orderDate    DateTime            @map("order_date")
  expectedDate DateTime?           @map("expected_date")
  totalAmount  Decimal             @default(0) @map("total_amount") @db.Decimal(15, 2)
  memo         String?
  // 발주가 매입견적서를 기반으로 작성된 경우
  quotationId  String?             @map("quotation_id")
  quotation    Quotation?          @relation(fields: [quotationId], references: [id])
  createdById  String              @map("created_by_id")
  createdBy    User                @relation(fields: [createdById], references: [id])
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")

  items        PurchaseOrderItem[]
  incomings    Incoming[]
  accessTokens PurchaseOrderAccessToken[]

  @@index([supplierId, orderDate])
  @@index([status])
  @@map("purchase_orders")
}

enum ProposalStatus {
  NONE      // 협상 없음 (기본)
  PENDING   // 거래처 제안, 우리 응답 대기
  ACCEPTED  // 우리가 수락 (proposedUnitPrice → unitPrice 적용됨)
  REJECTED  // 우리가 거절 (proposedUnitPrice 보존, 단가 미적용)
}

enum POAccessTokenStatus {
  ACTIVE      // 발급됨, 미사용
  VIEWED      // 거래처가 한 번 이상 봤음
  ACCEPTED    // 수락됨 (terminal)
  REJECTED    // 거절됨 (terminal)
  EXPIRED     // 만료
  REVOKED     // 재발송으로 폐기
}

// 거래처가 ERP 계정 없이 발주 내용 확인 + 수락/거절 할 수 있는 외부 접근 토큰.
// - 토큰: crypto.randomBytes(32).toString("base64url") 256bit
// - 단방향: 한번 ACCEPTED/REJECTED 되면 재사용 불가
// - 재발송 시 새 row 생성, 이전 토큰은 REVOKED (이력 보존)
model PurchaseOrderAccessToken {
  id              String              @id @default(uuid())
  purchaseOrderId String              @map("purchase_order_id")
  purchaseOrder   PurchaseOrder       @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  token           String              @unique
  status          POAccessTokenStatus @default(ACTIVE)
  expiresAt       DateTime            @map("expires_at")
  issuedAt        DateTime            @default(now()) @map("issued_at")
  firstViewedAt   DateTime?           @map("first_viewed_at")
  lastViewedAt    DateTime?           @map("last_viewed_at")
  viewCount       Int                 @default(0) @map("view_count")
  acceptedAt      DateTime?           @map("accepted_at")
  rejectedAt      DateTime?           @map("rejected_at")
  rejectionNote   String?             @map("rejection_note")
  viewerIp        String?             @map("viewer_ip")
  viewerUserAgent String?             @map("viewer_user_agent")

  @@index([purchaseOrderId, status])
  @@index([expiresAt])
  @@map("purchase_order_access_tokens")
}

model PurchaseOrderItem {
  id                String          @id @default(uuid())
  purchaseOrderId   String          @map("purchase_order_id")
  purchaseOrder     PurchaseOrder   @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  supplierProductId String          @map("supplier_product_id")
  supplierProduct   SupplierProduct @relation(fields: [supplierProductId], references: [id])
  quantity          Decimal         @db.Decimal(15, 4)
  // 분할 입고 누적 수량. quantity 도달 시 PurchaseOrder.status 가 RECEIVED 로 자동 전환.
  // 사용자가 "발주 종료" 누르면 잔량 무시하고 CLOSED.
  receivedQty       Decimal         @default(0) @map("received_qty") @db.Decimal(15, 4)
  unitPrice         Decimal         @map("unit_price") @db.Decimal(15, 2)
  totalPrice        Decimal         @map("total_price") @db.Decimal(15, 2)
  // 거래처가 토큰 페이지에서 제안한 새 단가.
  // 수락 시 unitPrice 로 옮기되 proposedUnitPrice 는 보존 (이력 표시용).
  // 거절 시에도 보존. 새 제안이 들어오면 덮어쓰여짐 (단일 라운드 추적).
  proposedUnitPrice     Decimal?               @map("proposed_unit_price") @db.Decimal(15, 2)
  proposalStatus        ProposalStatus         @default(NONE) @map("proposal_status")
  proposalRespondedAt   DateTime?              @map("proposal_responded_at")
  proposalRejectionNote String?                @map("proposal_rejection_note")
  memo                  String?
  sortOrder             Int                    @default(0) @map("sort_order")

  incomingItems IncomingItem[]

  @@map("purchase_order_items")
}

// ============================================================
// 주문 관리
// ============================================================

enum OrderStatus {
  PENDING           // 주문/접수 — channelId 있으면 "주문"(외부), 없으면 "접수"(매장). 재고 미차감
  PREPARING         // 출고대기 — 재고 차감됨, 포장·송장 발급 전. 취소 가능 마지막 단계
  PREPARING_PACKED  // 출고확정 — 포장·송장 입력 완료, 발송 직전. 취소 불가 (반품 흐름으로)
  SHIPPED           // 배송중 — 택배 인계 / 배달 출발
  COMPLETED         // 배송완료 — 인도 종결
  RETURN_REQUESTED  // 클레임 요청 — claimType 으로 반품/교환 분기. 매장 수락/반려 결정 전
  RETURN_ACCEPTED   // 클레임 수락 — 회수대기
  RETURN_COLLECTED  // 회수완료 — 물품 도착, 검수 전
  RETURN_INSPECTED  // 검수완료 — 다음에 환불(반품) 또는 교환출고로 분기
  RETURNED          // 반품완료 — 재고 복원 + 환불(또는 매출 취소) 종결
  EXCHANGED         // 교환완료 — 재고 복원 + 새 주문(-EX) 자동 생성. 차액 정산은 새 주문에서
  CANCELLED
}

/**
 * 결제 축 — 출고 상태(OrderStatus) 와 별개의 재무 상태.
 *  - UNPAID: 미수 (외상). UNPAID 인 채로 출고는 가능하지만 customer ledger 에 잔액 누적
 *  - PAID: 결제 완료
 *  - REFUND_PENDING: 환불 진행 중 (검수 후 PG/은행 처리 대기)
 *  - PARTIAL_REFUND: 일부 환불 (부분 반품 시)
 *  - REFUNDED: 전액 환불 완료
 *  - SALES_CANCELLED: 매출 취소 — 외상(UNPAID) 주문 반품. 환불 없이 customer ledger 잔액 차감
 */
enum OrderPaymentStatus {
  UNPAID
  PAID
  REFUND_PENDING
  PARTIAL_REFUND
  REFUNDED
  SALES_CANCELLED
}

/**
 * 클레임 종류 — 손님이 어떤 결과를 원하는지. 회수 후 처리 분기.
 *  - REFUND:             환불 종결 (RETURNED)
 *  - EXCHANGE_SAME:      같은 상품 재발송. 새 주문 자동 생성 (항목 복제, totalAmount=0)
 *  - EXCHANGE_DIFFERENT: 다른 상품으로 교체. 새 주문 자동 생성 (빈 항목, 사용자 편집 + 차액 정산)
 */
enum OrderClaimType {
  REFUND
  EXCHANGE_SAME
  EXCHANGE_DIFFERENT
}

/**
 * 클레임 사유 — 책임 소재 구분. 통계·정책(운임 부담 등)에 활용.
 *  - DEFECTIVE:          불량/하자 — 매장 책임
 *  - DAMAGED_IN_TRANSIT: 배송 중 파손 — 매장/택배사 책임
 *  - WRONG_ITEM:         오배송 — 매장 책임
 *  - CHANGE_MIND:        단순 변심 — 손님 책임
 *  - SIZE_COLOR:         사이즈/색상 변경 — 부분 손님 책임
 *  - OTHER:              기타
 */
enum OrderClaimReason {
  DEFECTIVE
  DAMAGED_IN_TRANSIT
  WRONG_ITEM
  CHANGE_MIND
  SIZE_COLOR
  OTHER
}

enum FulfillmentType {
  PICKUP        // 매장 수령 (POS 즉시 종결, 워크보드 미노출)
  DELIVERY      // 자체 배달 (당일·근거리)
  SHIPPING      // 택배 발송
}

model Order {
  id                  String              @id @default(uuid())
  orderNo             String              @unique @map("order_no")
  channelId           String?             @map("channel_id")
  channel             SalesChannel?       @relation(fields: [channelId], references: [id])
  channelOrderNo      String?             @map("channel_order_no")
  status              OrderStatus         @default(PENDING)
  fulfillmentType     FulfillmentType     @default(PICKUP) @map("fulfillment_type")
  expectedShipDate    DateTime?           @map("expected_ship_date") @db.Date
  customerId          String?             @map("customer_id")
  customer            Customer?           @relation(fields: [customerId], references: [id])
  /** 등록 고객 스냅샷 — POS 결제 시 받는 사람과 다를 수 있어 별도 보존 */
  customerName        String?             @map("customer_name")
  customerPhone       String?             @map("customer_phone")
  /** 받는 사람 (배송 시) — 등록 고객(customerName)과 다를 수 있음. PICKUP 일 땐 null */
  recipientName       String?             @map("recipient_name")
  recipientPhone      String?             @map("recipient_phone")
  shippingAddress     String?             @map("shipping_address")
  /** 택배사 (SHIPPED 후 입력) */
  trackingCarrier     String?             @map("tracking_carrier")
  /** 송장번호 (SHIPPED 후 입력) */
  trackingNumber      String?             @map("tracking_number")
  orderDate           DateTime            @map("order_date")
  quotationId         String?             @map("quotation_id")
  quotation           Quotation?          @relation(fields: [quotationId], references: [id])
  subtotalAmount      Decimal             @default(0) @map("subtotal_amount") @db.Decimal(15, 2)
  discountAmount      Decimal             @default(0) @map("discount_amount") @db.Decimal(15, 2)
  shippingFee         Decimal             @default(0) @map("shipping_fee") @db.Decimal(15, 2)
  taxAmount           Decimal             @default(0) @map("tax_amount") @db.Decimal(15, 2)
  totalAmount         Decimal             @default(0) @map("total_amount") @db.Decimal(15, 2)
  commissionAmount    Decimal             @default(0) @map("commission_amount") @db.Decimal(15, 2)
  paymentMethod       OrderPaymentMethod? @map("payment_method")
  /** 결제 축 — 출고 상태와 별개. 외상/환불 표현용 */
  paymentStatus       OrderPaymentStatus  @default(UNPAID) @map("payment_status")
  /** 반품 흐름 timestamp — 운영 로그 + 단계 추적 */
  returnRequestedAt   DateTime?           @map("return_requested_at")
  returnAcceptedAt    DateTime?           @map("return_accepted_at")
  returnRejectedAt    DateTime?           @map("return_rejected_at")
  /** 클레임 분기 — 환불/같은상품교환/다른상품교환. RETURN_REQUESTED 시 결정. */
  claimType           OrderClaimType?     @map("claim_type")
  claimReason         OrderClaimReason?   @map("claim_reason")
  /** 교환 종결 시 새 주문 link — 차액 정산은 새 주문에서 */
  exchangeOrderId     String?             @unique @map("exchange_order_id")
  exchangeOrder       Order?              @relation("OrderExchange", fields: [exchangeOrderId], references: [id])
  exchangedFromOrders Order[]             @relation("OrderExchange")
  exchangedAt         DateTime?           @map("exchanged_at")
  /** 클레임 메모 — 손님 자유 사유 + 매장 처리 메모 (claimReason enum 외 보충) */
  returnReason        String?             @map("return_reason")
  taxInvoiceRequested Boolean             @default(false) @map("tax_invoice_requested")
  taxInvoicedAt       DateTime?           @map("tax_invoiced_at")
  memo                String?
  // 한 RepairTicket / Rental 은 결제 Order 1건만 가질 수 있음 (1:1).
  // application-level idempotency 외에 DB 차원에서도 강제 — 미래 흐름 추가 시 안전망.
  repairTicketId      String?             @unique @map("repair_ticket_id")
  repairTicket        RepairTicket?       @relation(fields: [repairTicketId], references: [id])
  rentalId            String?             @unique @map("rental_id")
  rental              Rental?             @relation(fields: [rentalId], references: [id])
  createdById         String              @map("created_by_id")
  createdBy           User                @relation(fields: [createdById], references: [id])
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")

  items      OrderItem[]
  statements Statement[]

  @@index([channelId, orderDate])
  @@index([status])
  @@index([status, expectedShipDate])
  // 채널 import 중복 방지 — 동일 채널 내 channelOrderNo 는 한 번만 import.
  // PostgreSQL 의 unique 는 NULL 을 unique 로 보지 않으므로 오프라인(channelId=null) 주문은 영향 X.
  @@unique([channelId, channelOrderNo])
  // repairTicketId / rentalId 는 @unique 가 자동으로 unique index 생성 — 별도 @@index 불필요
  @@map("orders")
}

model OrderItem {
  id                            String   @id @default(uuid())
  orderId                       String   @map("order_id")
  order                         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId                     String?  @map("product_id")
  product                       Product? @relation(fields: [productId], references: [id])
  canonicalProductId            String?  @map("canonical_product_id")
  serviceName                   String?  @map("service_name")
  quantity                      Decimal  @db.Decimal(15, 4)
  /**
   * 정가(할인 전 단가, 세전) — 견적서/거래명세표 → 주문 전환 시 보존
   */
  listPrice                     Decimal? @map("list_price") @db.Decimal(15, 2)
  /**
   * 개당 할인액 (세전)
   */
  discountAmount                Decimal? @map("discount_amount") @db.Decimal(15, 2)
  unitPrice                     Decimal  @map("unit_price") @db.Decimal(15, 2)
  totalPrice                    Decimal  @map("total_price") @db.Decimal(15, 2)
  unitCostSnapshot              Decimal? @map("unit_cost_snapshot") @db.Decimal(15, 4)
  channelCommissionRateSnapshot Decimal? @map("channel_commission_rate_snapshot") @db.Decimal(5, 4)
  cardFeeRateSnapshot           Decimal? @map("card_fee_rate_snapshot") @db.Decimal(5, 4)
  sellingCostSnapshot           Decimal? @map("selling_cost_snapshot") @db.Decimal(15, 4)
  memo                          String?

  lotConsumptions LotConsumption[]
  serialItems     SerialItem[]

  @@map("order_items")
}

// ============================================================
// 로트 기반 재고 추적 (FIFO)
// ============================================================

enum LotSource {
  INCOMING
  INITIAL
  ADJUSTMENT
  SET_PRODUCE
}

model InventoryLot {
  id                String           @id @default(uuid())
  productId         String?          @map("product_id")
  product           Product?         @relation(fields: [productId], references: [id])
  supplierProductId String?          @map("supplier_product_id")
  supplierProduct   SupplierProduct? @relation(fields: [supplierProductId], references: [id])
  receivedQty       Decimal          @map("received_qty") @db.Decimal(15, 4)
  remainingQty      Decimal          @map("remaining_qty") @db.Decimal(15, 4)
  unitCost          Decimal          @map("unit_cost") @db.Decimal(15, 4)
  originalPrice     Decimal?         @map("original_price") @db.Decimal(15, 4)
  discountAmount    Decimal?         @map("discount_amount") @db.Decimal(15, 4)
  receivedAt        DateTime         @map("received_at")
  source            LotSource
  incomingItemId    String?          @map("incoming_item_id")
  incomingItem      IncomingItem?    @relation(fields: [incomingItemId], references: [id])
  memo              String?
  createdAt         DateTime         @default(now()) @map("created_at")

  consumptions LotConsumption[]

  @@index([productId, receivedAt])
  @@index([supplierProductId, receivedAt])
  @@index([incomingItemId])
  @@map("inventory_lots")
}

model LotConsumption {
  id           String       @id @default(uuid())
  orderItemId  String?      @map("order_item_id")
  orderItem    OrderItem?   @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  repairPartId String?      @map("repair_part_id")
  repairPart   RepairPart?  @relation(fields: [repairPartId], references: [id], onDelete: Cascade)
  lotId        String       @map("lot_id")
  lot          InventoryLot @relation(fields: [lotId], references: [id])
  quantity     Decimal      @db.Decimal(15, 4)
  unitCost     Decimal      @map("unit_cost") @db.Decimal(15, 4)
  createdAt    DateTime     @default(now()) @map("created_at")

  @@index([orderItemId])
  @@index([repairPartId])
  @@index([lotId])
  @@map("lot_consumptions")
}

// ============================================================
// 반품 관리
