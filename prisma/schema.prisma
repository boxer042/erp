// ============================================================
// 고객 (Customer) — 판매 상대방
// ============================================================

enum CustomerType {
  INDIVIDUAL // 개인
  BUSINESS // 기업/사업자
}

model Customer {
  id              String       @id @default(uuid())
  type            CustomerType @default(INDIVIDUAL)
  // 공통: 개인=이름, 기업=상호
  name            String
  phone           String
  email           String?
  memo            String?
  // 기업 전용 (type=BUSINESS 일 때 의미)
  businessNumber  String?      @map("business_number")
  ceo             String? // 대표자명
  fax             String?
  businessType    String?      @map("business_type") // 업태
  businessItem    String?      @map("business_item") // 종목
  // 주소 — 사업장(기업)/기본(개인) + 배송지 (다를 때만 채움)
  address         String?
  shippingAddress String?      @map("shipping_address")
  // 기업 담당자 (대표 외 실무 연락처) — 개인은 미사용
  contactName     String?      @map("contact_name")
  contactPhone    String?      @map("contact_phone")
  contactPosition String?      @map("contact_position")
  isActive        Boolean      @default(true) @map("is_active")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  quotations  Quotation[]
  statements  Statement[]
  orders      Order[]
  ledger      CustomerLedger[]
  payments    CustomerPayment[]
  machines    CustomerMachine[]
  notes       CustomerNote[]
  repairs     RepairTicket[]
  rentals     Rental[]
  expenses    Expense[]
  serialItems SerialItem[]
  posSessions PosSession[]

  @@index([name])
  @@index([phone])
  @@index([businessNumber])
  @@index([type])
  @@map("customers")
}

enum CustomerLedgerType {
  SALE // 매출 (미수금 증가)
  RECEIPT // 수금 (미수금 감소)
  ADJUSTMENT
  REFUND // 환불 (미수금 증가)
}

model CustomerLedger {
  id            String             @id @default(uuid())
  customerId    String             @map("customer_id")
  customer      Customer           @relation(fields: [customerId], references: [id])
  date          DateTime           @default(now())
  type          CustomerLedgerType
  description   String
  debitAmount   Decimal            @default(0) @map("debit_amount") @db.Decimal(15, 2) // 매출/환불(증가)
  creditAmount  Decimal            @default(0) @map("credit_amount") @db.Decimal(15, 2) // 수금(감소)
  balance       Decimal            @map("balance") @db.Decimal(15, 2)
  referenceId   String?            @map("reference_id")
  referenceType String?            @map("reference_type")
  createdAt     DateTime           @default(now()) @map("created_at")

  @@index([customerId, date])
  @@map("customer_ledgers")
}

model CustomerPayment {
  id          String   @id @default(uuid())
  customerId  String   @map("customer_id")
  customer    Customer @relation(fields: [customerId], references: [id])
  amount      Decimal  @db.Decimal(15, 2)
  paymentDate DateTime @map("payment_date")
  method      String
  memo        String?
  createdById String   @map("created_by_id")
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([customerId, paymentDate])
  @@map("customer_payments")
}

// ============================================================
// 견적서 (Quotation) — 판매/매입 통합
// ============================================================

enum QuotationType {
  SALES
  PURCHASE
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
  CONVERTED
}

model Quotation {
  id             String          @id @default(uuid())
  quotationNo    String          @unique @map("quotation_no")
  type           QuotationType
  status         QuotationStatus @default(DRAFT)
  issueDate      DateTime        @map("issue_date")
  validUntil     DateTime?       @map("valid_until")
  customerId     String?         @map("customer_id")
  customer       Customer?       @relation(fields: [customerId], references: [id])
  supplierId     String?         @map("supplier_id")
  supplier       Supplier?       @relation(fields: [supplierId], references: [id])
  title          String?
  subtotalAmount Decimal         @default(0) @map("subtotal_amount") @db.Decimal(15, 2)
  taxAmount      Decimal         @default(0) @map("tax_amount") @db.Decimal(15, 2)
  totalAmount    Decimal         @default(0) @map("total_amount") @db.Decimal(15, 2)
  memo           String?
  terms          String?
  createdById    String          @map("created_by_id")
  createdBy      User            @relation(fields: [createdById], references: [id])
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  items          QuotationItem[]
  orders         Order[]
  incomings      Incoming[]
  purchaseOrders PurchaseOrder[]
  statements     Statement[]

  @@index([type, issueDate])
  @@index([status])
  @@map("quotations")
}

model QuotationItem {
  id                String           @id @default(uuid())
  quotationId       String           @map("quotation_id")
  quotation         Quotation        @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  productId         String?          @map("product_id")
  product           Product?         @relation(fields: [productId], references: [id])
  supplierProductId String?          @map("supplier_product_id")
  supplierProduct   SupplierProduct? @relation(fields: [supplierProductId], references: [id])
  name              String
  spec              String?
  unitOfMeasure     String           @default("EA") @map("unit_of_measure")
  quantity          Decimal          @db.Decimal(15, 4)
  listPrice         Decimal          @default(0) @map("list_price") @db.Decimal(15, 2)
  discountAmount    Decimal          @default(0) @map("discount_amount") @db.Decimal(15, 2)
  unitPrice         Decimal          @map("unit_price") @db.Decimal(15, 2)
  totalPrice        Decimal          @map("total_price") @db.Decimal(15, 2)
  isTaxable         Boolean          @default(true) @map("is_taxable")
  sortOrder         Int              @default(0) @map("sort_order")
  memo              String?

  @@map("quotation_items")
}

// ============================================================
// 거래명세표 (Statement) — 판매용
// ============================================================

enum StatementStatus {
  DRAFT
  ISSUED
  CANCELLED
}

model Statement {
  id                             String          @id @default(uuid())
  statementNo                    String          @unique @map("statement_no")
  status                         StatementStatus @default(ISSUED)
  issueDate                      DateTime        @map("issue_date")
  customerId                     String?         @map("customer_id")
  customer                       Customer?       @relation(fields: [customerId], references: [id])
  customerNameSnapshot           String?         @map("customer_name_snapshot")
  customerPhoneSnapshot          String?         @map("customer_phone_snapshot")
  customerAddressSnapshot        String?         @map("customer_address_snapshot")
  customerBusinessNumberSnapshot String?         @map("customer_business_number_snapshot")
  orderId                        String?         @map("order_id")
  order                          Order?          @relation(fields: [orderId], references: [id])
  quotationId                    String?         @map("quotation_id")
  quotation                      Quotation?      @relation(fields: [quotationId], references: [id])
  subtotalAmount                 Decimal         @default(0) @map("subtotal_amount") @db.Decimal(15, 2)
  taxAmount                      Decimal         @default(0) @map("tax_amount") @db.Decimal(15, 2)
  totalAmount                    Decimal         @default(0) @map("total_amount") @db.Decimal(15, 2)
  memo                           String?
  createdById                    String          @map("created_by_id")
  createdBy                      User            @relation(fields: [createdById], references: [id])
  createdAt                      DateTime        @default(now()) @map("created_at")
  updatedAt                      DateTime        @updatedAt @map("updated_at")

  items StatementItem[]

  @@index([issueDate])
  @@map("statements")
}

model StatementItem {
  id             String    @id @default(uuid())
  statementId    String    @map("statement_id")
  statement      Statement @relation(fields: [statementId], references: [id], onDelete: Cascade)
  productId      String?   @map("product_id")
  product        Product?  @relation(fields: [productId], references: [id])
  name           String
  spec           String?
  unitOfMeasure  String    @default("EA") @map("unit_of_measure")
  quantity       Decimal   @db.Decimal(15, 4)
  listPrice      Decimal   @default(0) @map("list_price") @db.Decimal(15, 2)
  discountAmount Decimal   @default(0) @map("discount_amount") @db.Decimal(15, 2)
  unitPrice      Decimal   @map("unit_price") @db.Decimal(15, 2)
  totalPrice     Decimal   @map("total_price") @db.Decimal(15, 2)
  isTaxable      Boolean   @default(true) @map("is_taxable")
  sortOrder      Int       @default(0) @map("sort_order")
  memo           String?

  @@map("statement_items")
}

// ============================================================
// POS — 상품 미디어, 결제수단, 고객 보유 기계, 방문 메모
// ============================================================

enum ProductMediaType {
  IMAGE
  YOUTUBE
}

enum ProductMediaKind {
  THUMBNAIL // 1:1 정사각, 상품 카드/리스트 썸네일용
  DETAIL // 자유 비율, 상품 상세 페이지 슬라이드/디테일샷
}

model ProductMedia {
