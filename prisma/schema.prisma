model CustomerNote {
  id          String   @id @default(uuid())
  customerId  String   @map("customer_id")
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  content     String
  createdById String   @map("created_by_id")
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([customerId, createdAt])
  @@map("customer_notes")
}

// ============================================================
// 수리 (RepairTicket)
// ============================================================

enum RepairStatus {
  RECEIVED // 접수
  DIAGNOSING // 진단 중 (DROP_OFF만)
  QUOTED // 견적 안내 (DROP_OFF만)
  APPROVED // 손님 승인 (DROP_OFF만)
  REPAIRING // 수리 중
  READY // 완료, 픽업 대기
  PICKED_UP // 픽업/결제 완료
  CANCELLED // 거절(DECLINED)/취소 — 진단비만 청구
}

enum RepairApprovalMethod {
  ON_SITE
  REMOTE
}

enum RepairType {
  ON_SITE // 즉시수리 — POS 카트에서 받자마자 수리·결제
  DROP_OFF // 맡김수리 — 받아두고 며칠 내 수리 후 픽업
}

enum RepairPartStatus {
  USED // 정상 사용 — 청구 포함
  LOST // 손실 (수리 실패·교체로 망가짐) — 청구 제외, 재고는 차감 유지 → 매출원가 손실
}

// 수리 취소 사유 — 분석/고객응대용
enum RepairCancelReason {
  CUSTOMER_DECLINED // 손님이 거절 (견적 본 후 진행 안 함)
  CUSTOMER_NO_SHOW // 손님 미반환 (맡겼는데 안 찾으러 옴)
  SHOP_GAVE_UP // 매장 포기 (수리 불가 판정)
  PARTS_UNAVAILABLE // 부속 수급 불가
  SOLD_AS_PRODUCT // 수리 대신 상품 구매로 전환 (같은 또는 다른 제품) — 보존 가치 있음
  MISTAKE // 잘못 생성 (실수로 만든 티켓 — 진단·자료 무의미)
  OTHER // 기타 (cancelMemo 참조)
}

model RepairTicket {
  id                     String                @id @default(uuid())
  ticketNo               String                @unique @map("ticket_no")
  type                   RepairType            @default(ON_SITE)
  customerId             String?               @map("customer_id")
  customer               Customer?             @relation(fields: [customerId], references: [id])
  customerMachineId      String?               @map("customer_machine_id")
  customerMachine        CustomerMachine?      @relation(fields: [customerMachineId], references: [id])
  serialItemId           String?               @map("serial_item_id")
  serialItem             SerialItem?           @relation(fields: [serialItemId], references: [id], onDelete: SetNull)
  status                 RepairStatus          @default(RECEIVED)
  receivedAt             DateTime              @map("received_at")
  symptom                String?
  diagnosis              String?
  repairNotes            String?               @map("repair_notes")
  // 가져온 기기 정보 — 시리얼/판매상품 카탈로그에 없을 때 자유 입력 fallback
  repairProductId        String?               @map("repair_product_id")
  repairProduct          Product?              @relation("RepairProduct", fields: [repairProductId], references: [id], onDelete: SetNull)
  repairProductText      String?               @map("repair_product_text") // 카탈로그에 없을 때 자유 입력 (예: "Sony A7M4 Black")
  diagnosisFee           Decimal               @default(0) @map("diagnosis_fee") @db.Decimal(15, 2)
  totalDiscount          String                @default("0") @map("total_discount") // "1000" or "10%"
  quotedLaborAmount      Decimal               @default(0) @map("quoted_labor_amount") @db.Decimal(15, 2)
  quotedPartsAmount      Decimal               @default(0) @map("quoted_parts_amount") @db.Decimal(15, 2)
  quotedTotalAmount      Decimal               @default(0) @map("quoted_total_amount") @db.Decimal(15, 2)
  quotedAt               DateTime?             @map("quoted_at")
  approvalMethod         RepairApprovalMethod? @map("approval_method")
  approvalToken          String?               @unique @map("approval_token")
  approvalTokenExpiresAt DateTime?             @map("approval_token_expires_at")
  approvedAt             DateTime?             @map("approved_at")
  approvedByName         String?               @map("approved_by_name")
  startedAt              DateTime?             @map("started_at")
  readyAt                DateTime?             @map("ready_at")
  pickedUpAt             DateTime?             @map("picked_up_at")
  finalAmount            Decimal               @default(0) @map("final_amount") @db.Decimal(15, 2)
  paymentMethod          OrderPaymentMethod?   @map("payment_method")
  // 수리 보증 — 픽업(완료) 시점부터 시작
  repairWarrantyMonths   Int?                  @map("repair_warranty_months")
  repairWarrantyEnds     DateTime?             @map("repair_warranty_ends")
  // 재수리 — 보증 내 같은 증상으로 다시 입고
  parentRepairTicketId   String?               @map("parent_repair_ticket_id")
  parentRepairTicket     RepairTicket?         @relation("RepairRevisits", fields: [parentRepairTicketId], references: [id], onDelete: SetNull)
  revisits               RepairTicket[]        @relation("RepairRevisits")
  // 작업자 지정
  assignedToId           String?               @map("assigned_to_id")
  assignedTo             User?                 @relation("RepairAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  // 취소 정보 (status=CANCELLED 일 때만 의미)
  cancelReason           RepairCancelReason?   @map("cancel_reason")
  cancelMemo             String?               @map("cancel_memo") // OTHER 사유 또는 추가 설명
  cancelledAt            DateTime?             @map("cancelled_at")
  // 미등록 손님 추적 — POS 의 어떤 카트 세션에서 만들어졌는지 (등록 손님이면 customerId 로 충분)
  // 클라이언트 sessions.repairTicketIds 추적이 끊겨도 DB 에서 복원 가능. 세션 자체가 사라지면 NULL.
  posSessionId           String?               @map("pos_session_id")
  posSession             PosSession?           @relation(fields: [posSessionId], references: [id], onDelete: SetNull)
  // 새 수리 접수 시 선택한 상품 카테고리 — 수리 진행 페이지의 "카테고리" 검색 모드에서 사용.
  // null = "기타" (카테고리 미지정 또는 없는 항목)
  repairCategoryId       String?               @map("repair_category_id")
  repairCategory         ProductCategory?      @relation("RepairCategory", fields: [repairCategoryId], references: [id], onDelete: SetNull)
  memo                   String?
  createdById            String                @map("created_by_id")
  createdBy              User                  @relation(fields: [createdById], references: [id])
  createdAt              DateTime              @default(now()) @map("created_at")
  updatedAt              DateTime              @updatedAt @map("updated_at")

  parts  RepairPart[]
  labors RepairLabor[]
  // Order.repairTicketId 가 @unique 이므로 1:1 — 결제 Order 0~1건
  order  Order?

  @@index([customerId])
  @@index([status])
  @@index([receivedAt])
  @@index([assignedToId])
  @@index([parentRepairTicketId])
  @@index([serialItemId])
  @@index([posSessionId])
  @@index([repairCategoryId])
  @@map("repair_tickets")
}

model RepairPart {
  id               String           @id @default(uuid())
  repairTicketId   String           @map("repair_ticket_id")
  repairTicket     RepairTicket     @relation(fields: [repairTicketId], references: [id], onDelete: Cascade)
  productId        String           @map("product_id")
  product          Product          @relation(fields: [productId], references: [id])
  quantity         Decimal          @db.Decimal(15, 4)
  unitPrice        Decimal          @map("unit_price") @db.Decimal(15, 2)
  totalPrice       Decimal          @map("total_price") @db.Decimal(15, 2)
  unitCostSnapshot Decimal?         @map("unit_cost_snapshot") @db.Decimal(15, 4)
  consumedAt       DateTime?        @map("consumed_at")
  status           RepairPartStatus @default(USED)
  // LOST 부속 손님 청구 여부 — true 면 합계에 포함되어 청구. false (기본) 면 회사 손실.
  // 케이스: 수리 도중 손님 포기 시 일부 부속비 청구. status=LOST 일 때만 의미.
  billLost         Boolean          @default(false) @map("bill_lost")
  discount         String           @default("0") // 라인 할인 — "1000" or "10%"
  createdAt        DateTime         @default(now()) @map("created_at")

  lotConsumptions LotConsumption[]

  @@index([repairTicketId])
  @@map("repair_parts")
}

model RepairLabor {
  id             String       @id @default(uuid())
  repairTicketId String       @map("repair_ticket_id")
  repairTicket   RepairTicket @relation(fields: [repairTicketId], references: [id], onDelete: Cascade)
  name           String
  hours          Decimal      @default(1) @db.Decimal(10, 2)
  unitRate       Decimal      @map("unit_rate") @db.Decimal(15, 2)
  totalPrice     Decimal      @map("total_price") @db.Decimal(15, 2)
  createdAt      DateTime     @default(now()) @map("created_at")

  @@index([repairTicketId])
  @@map("repair_labors")
}

// ============================================================
// 수리 서비스 카탈로그 (공임 프리셋 / 수리 패키지)
// ============================================================

model RepairLaborPreset {
  id          String   @id @default(uuid())
  name        String
  description String?
  unitRate    Decimal  @map("unit_rate") @db.Decimal(15, 2)
  isActive    Boolean  @default(true) @map("is_active")
  memo        String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  packageLabors RepairPackageLabor[]

  @@map("repair_labor_presets")
}

model RepairPackage {
  id          String   @id @default(uuid())
  name        String
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  memo        String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  labors RepairPackageLabor[]
  parts  RepairPackagePart[]

  @@map("repair_packages")
}

model RepairPackageLabor {
  id            String             @id @default(uuid())
  packageId     String             @map("package_id")
  package       RepairPackage      @relation(fields: [packageId], references: [id], onDelete: Cascade)
  laborPresetId String?            @map("labor_preset_id")
  laborPreset   RepairLaborPreset? @relation(fields: [laborPresetId], references: [id])
  name          String
  unitRate      Decimal            @map("unit_rate") @db.Decimal(15, 2)
  quantity      Int                @default(1)
  sortOrder     Int                @default(0) @map("sort_order")

  @@index([packageId])
  @@map("repair_package_labors")
}

model RepairPackagePart {
  id        String        @id @default(uuid())
  packageId String        @map("package_id")
  package   RepairPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  productId String        @map("product_id")
  product   Product       @relation(fields: [productId], references: [id])
  quantity  Decimal       @db.Decimal(15, 4)
  unitPrice Decimal       @map("unit_price") @db.Decimal(15, 2)

  @@index([packageId])
  @@map("repair_package_parts")
}

// ============================================================
// 임대 (RentalAsset / Rental) — 판매 재고와 완전 분리
// ============================================================

enum RentalAssetStatus {
  AVAILABLE
  RENTED
  MAINTENANCE
  RETIRED
}

enum RentalRateType {
  DAILY
  MONTHLY
}

enum RentalStatus {
  RESERVED
  ACTIVE
  RETURNED
  OVERDUE
  CANCELLED
}

model RentalAsset {
  id            String            @id @default(uuid())
  assetNo       String            @unique @map("asset_no")
  name          String
  brand         String?
  modelNo       String?           @map("model_no")
  serialNo      String?           @map("serial_no")
  productId     String?           @map("product_id")
  product       Product?          @relation(fields: [productId], references: [id])
  dailyRate     Decimal           @default(0) @map("daily_rate") @db.Decimal(15, 2)
  monthlyRate   Decimal           @default(0) @map("monthly_rate") @db.Decimal(15, 2)
  depositAmount Decimal           @default(0) @map("deposit_amount") @db.Decimal(15, 2)
  status        RentalAssetStatus @default(AVAILABLE)
  acquiredAt    DateTime?         @map("acquired_at")
  memo          String?
  isActive      Boolean           @default(true) @map("is_active")
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")

  rentals Rental[]

  @@map("rental_assets")
}

model Rental {
  id               String              @id @default(uuid())
  rentalNo         String              @unique @map("rental_no")
  assetId          String              @map("asset_id")
  asset            RentalAsset         @relation(fields: [assetId], references: [id])
  customerId       String              @map("customer_id")
  customer         Customer            @relation(fields: [customerId], references: [id])
  status           RentalStatus        @default(RESERVED)
  startDate        DateTime            @map("start_date")
  endDate          DateTime            @map("end_date")
  actualReturnedAt DateTime?           @map("actual_returned_at")
  rateType         RentalRateType      @map("rate_type")
  unitRate         Decimal             @map("unit_rate") @db.Decimal(15, 2)
  totalUnits       Int                 @map("total_units")
  rentalAmount     Decimal             @map("rental_amount") @db.Decimal(15, 2)
  depositAmount    Decimal             @default(0) @map("deposit_amount") @db.Decimal(15, 2)
  depositReturned  Boolean             @default(false) @map("deposit_returned")
  overdueAmount    Decimal             @default(0) @map("overdue_amount") @db.Decimal(15, 2)
  finalAmount      Decimal             @default(0) @map("final_amount") @db.Decimal(15, 2)
  paymentMethod    OrderPaymentMethod? @map("payment_method")
  /**
   * 픽업/접수 시각 — 카트에서 임대 라인을 추가한 순간 캡처. 시간대별 임대 트래픽 분석용.
   */
  checkoutAt       DateTime?           @map("checkout_at")
  memo             String?
  createdById      String              @map("created_by_id")
  createdBy        User                @relation(fields: [createdById], references: [id])
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")

  // Order.rentalId 가 @unique 이므로 1:1 — 결제 Order 0~1건
  order Order?

  @@index([customerId])
  @@index([assetId])
  @@index([status])
  @@index([startDate, endDate])
  @@index([checkoutAt])
  @@map("rentals")
}

model Expense {
  id             String              @id @default(uuid())
  date           DateTime
  amount         Decimal             @db.Decimal(12, 2)
  category       ExpenseCategory
  description    String
  isTaxable      Boolean             @default(true) @map("is_taxable")
  recoverable    Boolean             @default(false) @map("recoverable")
  paymentMethod  OrderPaymentMethod? @map("payment_method")
  supplierId     String?             @map("supplier_id")
  supplier       Supplier?           @relation(fields: [supplierId], references: [id])
  customerId     String?             @map("customer_id")
  customer       Customer?           @relation(fields: [customerId], references: [id])
  createdById    String?             @map("created_by_id")
  createdBy      User?               @relation(fields: [createdById], references: [id])
  referenceId    String?             @map("reference_id")
  referenceType  String?             @map("reference_type")
  memo           String?
  attachmentUrl  String?             @map("attachment_url")
  attachmentPath String?             @map("attachment_path")
  attachmentName String?             @map("attachment_name")
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")

  @@index([date])
  @@index([category])
  @@index([supplierId])
  @@index([customerId])
  @@index([createdById])
  @@map("expenses")
}

enum ExpenseCategory {
  SHIPPING
  RENT
  UTILITIES
  SALARY
  PACKAGING
  OFFICE_SUPPLIES
  MARKETING
  MAINTENANCE
  INVENTORY_USAGE
  OTHER
}

// ============================================================
// 조립상품 템플릿 · 프리셋
// ============================================================

model AssemblyTemplate {
  id               String   @id @default(uuid())
  name             String
  description      String?
  defaultLaborCost Decimal? @map("default_labor_cost") @db.Decimal(15, 2)
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  slots              AssemblyTemplateSlot[]
  presets            AssemblyPreset[]
  defaultForProducts Product[]              @relation("ProductDefaultTemplate")

  @@map("assembly_templates")
}

model AssemblyTemplateSlot {
  id               String             @id @default(uuid())
  templateId       String             @map("template_id")
  template         AssemblyTemplate   @relation(fields: [templateId], references: [id], onDelete: Cascade)
  label            String
  slotLabelId      String?            @map("slot_label_id")
  slotLabel        AssemblySlotLabel? @relation(fields: [slotLabelId], references: [id], onDelete: Restrict)
  order            Int
  defaultProductId String?            @map("default_product_id")
  defaultProduct   Product?           @relation(fields: [defaultProductId], references: [id], onDelete: SetNull)
  defaultQuantity  Decimal            @default(1) @map("default_quantity") @db.Decimal(10, 4)
  isVariable       Boolean            @default(false) @map("is_variable")

  presetItems   AssemblyPresetItem[]
  setComponents SetComponent[]

  @@index([templateId, order])
  @@index([slotLabelId])
  @@map("assembly_template_slots")
}

model AssemblySlotLabel {
  id        String   @id @default(uuid())
  name      String   @unique
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  slots         AssemblyTemplateSlot[]
  setComponents SetComponent[]

  @@map("assembly_slot_labels")
}

model AssemblyPreset {
  id          String           @id @default(uuid())
  templateId  String           @map("template_id")
  template    AssemblyTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  name        String
  description String?
  isActive    Boolean          @default(true) @map("is_active")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  items AssemblyPresetItem[]

  @@unique([templateId, name])
  @@map("assembly_presets")
}

model AssemblyPresetItem {
  id        String               @id @default(uuid())
  presetId  String               @map("preset_id")
  preset    AssemblyPreset       @relation(fields: [presetId], references: [id], onDelete: Cascade)
  slotId    String               @map("slot_id")
  slot      AssemblyTemplateSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
  productId String               @map("product_id")
  product   Product              @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity  Decimal              @db.Decimal(10, 4)

  @@unique([presetId, slotId])
  @@map("assembly_preset_items")
}

// ============================================================
// 조립 실적 (Assembly / Disassembly)
// ============================================================

enum AssemblyType {
  PRODUCE
  DISASSEMBLE
}

model Assembly {
  id            String       @id @default(uuid())
  assemblyNo    String       @unique @map("assembly_no")
  productId     String       @map("product_id")
  product       Product      @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity      Decimal      @db.Decimal(10, 4)
  type          AssemblyType @default(PRODUCE)
  laborCost     Decimal?     @map("labor_cost") @db.Decimal(15, 2)
  assembledAt   DateTime     @map("assembled_at")
  memo          String?
  producedLotId String?      @map("produced_lot_id")
  reverseOfId   String?      @unique @map("reverse_of_id")
  reverseOf     Assembly?    @relation("AssemblyReverse", fields: [reverseOfId], references: [id])
  reversedBy    Assembly?    @relation("AssemblyReverse")
  createdBy     String?      @map("created_by")
  createdAt     DateTime     @default(now()) @map("created_at")

  consumptions AssemblyComponentConsumption[]

  @@index([productId, assembledAt])
  @@map("assemblies")
}

model AssemblyComponentConsumption {
  id          String   @id @default(uuid())
  assemblyId  String   @map("assembly_id")
  assembly    Assembly @relation(fields: [assemblyId], references: [id], onDelete: Cascade)
  componentId String   @map("component_id")
  component   Product  @relation(fields: [componentId], references: [id], onDelete: Restrict)
  lotId       String   @map("lot_id")
  quantity    Decimal  @db.Decimal(10, 4)
  unitCost    Decimal  @map("unit_cost") @db.Decimal(15, 4)

  @@index([assemblyId])
  @@index([lotId])
  @@map("assembly_component_consumptions")
}

// ============================================================
// SerialItem — 개별 시리얼 라벨 (큰 상품 추적용)
// 자세한 기획은 docs/serial-item-plan.md 참조
// ============================================================

enum SerialItemStatus {
  ACTIVE
  RETURNED
  SCRAPPED
}

// 시리얼 라벨 발번 출처. SALE=일반 판매, REPAIR=수리 받으러 온 기기에 부여(시스템 도입 전 판매분 등).
enum SerialItemSource {
  SALE
  REPAIR
}

model SerialItem {
  id           String           @id @default(uuid())
  code         String           @unique // "YYMMDD-NNNN" — 일별 4자리 시퀀스
  // productId 는 nullable — 외부에서 가져온 기기(카탈로그에 없음) 의 수리 라벨은 productId 없이
  // displayName 만으로 식별. 일반 판매 라벨은 productId 가 있고 displayName 은 null.
  productId    String?          @map("product_id")
  product      Product?         @relation(fields: [productId], references: [id], onDelete: SetNull)
  displayName  String?          @map("display_name") // 카탈로그 없는 기기명 (예: "Sony A7M4 Black")
  source       SerialItemSource @default(SALE)
  orderItemId  String?          @map("order_item_id")
  orderItem    OrderItem?       @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  customerId   String?          @map("customer_id")
  customer     Customer?        @relation(fields: [customerId], references: [id], onDelete: SetNull)
  soldAt       DateTime         @map("sold_at")
  warrantyEnds DateTime?        @map("warranty_ends")
  status       SerialItemStatus @default(ACTIVE)
  memo         String?
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  repairTickets RepairTicket[]

  @@index([code])
  @@index([productId])
  @@index([customerId])
  @@index([orderItemId])
  @@index([source])
  @@map("serial_items")
}

// ============================================================
// POS 카트 세션 — 디바이스간 공유용 서버 저장소
// ============================================================

// 한 user 의 카트 세션을 여러 기기에서 공유. id 는 클라이언트 sessionId 그대로
// 사용(genClientId). items / labelCodes / repairTicketIds 는 JSON 으로 저장 —
// 정규화는 매 push 마다 부담 크고, 카트는 결제 시까지 임시 데이터라 큰 의미 없음.
model PosSession {
  id                   String    @id // 클라이언트 sessionId 와 동일
  userId               String    @map("user_id")
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // 고객 — 등록 고객은 customerId, 미등록은 null + customerName 도 null
  customerId           String?   @map("customer_id")
  customer             Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerName         String?   @map("customer_name")
  customerPhone        String?   @map("customer_phone")
  // 카트 메타
  label                String    @default("고객")
  totalDiscount        String    @default("0") @map("total_discount")
  shippingCost         String    @default("0") @map("shipping_cost")
  items                Json      @default("[]") // CartItem[] — JSON 직렬화
  // 견적/라벨/수리 추적 (모두 옵셔널)
  quotationId          String?   @map("quotation_id")
  quotationFingerprint String?   @map("quotation_fingerprint")
  labelCodes           Json?     @map("label_codes")
  labelFingerprint     String?   @map("label_fingerprint")
  repairTicketIds      Json?     @map("repair_ticket_ids") // string[] — deprecated, RepairTicket.posSessionId 로 대체. 호환성 유지를 위해 잠시 보존
  openRepairCount      Int?      @map("open_repair_count")
  // 동기화 메타
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")
  // soft delete — 다른 기기가 옛 sessionStorage 데이터로 sync 해서 부활하는 것을 막기 위함.
  // null = active. 값 있으면 GET 응답에서 제외 + POST 시 그 id 로 들어온 upsert 거부.
  deletedAt            DateTime? @map("deleted_at")
  // 장바구니 저장 — null = 그리드 활성, 값 있으면 그리드에서 숨기되 "저장된 상담" 페이지에서 부활 가능.
  // 라인의 productId 만 의미있고 가격은 부활 시점에 현재 sellingPrice 로 다시 계산.
  parkedAt             DateTime? @map("parked_at")

  // 역참조 — 이 세션에서 만든 미등록 손님의 수리 티켓들 (등록 손님은 customer.repairs 로)
  repairTickets RepairTicket[]

  @@index([userId])
  @@index([userId, updatedAt])
  @@index([customerId])
  @@index([deletedAt])
  @@index([userId, parkedAt])
  @@map("pos_sessions")
}
